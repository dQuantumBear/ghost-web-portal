---
// Ghost Relay - Gateway v1.4 (Final Launch Build)
---
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SECURE MESSENGER | Ghost Relay Gateway</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;700&display=swap');
        body { font-family: 'Inter', sans-serif; background-color: #000; color: #00ff41; }
        .glass-card {
            background: rgba(10, 10, 10, 0.8);
            border: 1px solid rgba(0, 255, 65, 0.2);
            border-radius: 20px;
            backdrop-filter: blur(10px);
        }
        /* Custom constrained sizes to prevent "giant" icons */
        .logo-constrained { width: 120px !important; height: 120px !important; }
        .radar-constrained { width: 220px !important; height: 220px !important; }
    </style>
</head>
<body class="flex flex-col items-center justify-center min-h-screen p-6 overflow-hidden relative">

    <div class="fixed top-[-40px] right-[-40px] opacity-10 pointer-events-none z-0">
        <img src="/radar.png" alt="" class="radar-constrained animate-pulse object-contain" />
    </div>

    <div class="max-w-md w-full z-10 text-center">
        
        <div class="relative inline-block mb-10">
            <div class="absolute inset-0 bg-[#00ff41] blur-3xl opacity-10 rounded-full"></div>
            <img src="/logo.png" alt="Secure Messenger Logo" class="logo-constrained relative z-10 mx-auto" />
        </div>

        <header class="mb-12">
            <h1 class="text-white text-3xl font-bold tracking-tight mb-2 uppercase italic">
                Secure <span class="text-[#00ff41]">Messenger</span>
            </h1>
            <p class="text-[10px] tracking-[0.4em] opacity-40 uppercase font-light">Powered by Ghost Relay Protocol</p>
        </header>

        <div class="space-y-4">
            <a href="#" class="glass-card w-full p-5 flex items-center justify-between group hover:border-[#00ff41]/60 transition-all block">
                <span class="text-white font-medium uppercase tracking-widest text-[10px]">Download Android APK</span>
                <img src="/arrow.png" class="h-4 opacity-70 group-hover:translate-x-1 transition-all" />
            </a>

            <a href="#" class="glass-card w-full p-5 flex items-center justify-between group hover:border-[#00ff41]/60 transition-all block">
                <span class="text-white font-medium uppercase tracking-widest text-[10px]">Technical White Paper</span>
                <div class="w-1.5 h-1.5 rounded-full bg-[#00ff41] animate-pulse"></div>
            </a>
        </div>

        <footer class="mt-20 opacity-30">
            <p class="text-[9px] uppercase tracking-[0.3em] mb-4 italic">"Visibility is a choice. We choose none."</p>
            <div class="text-[8px] uppercase tracking-widest">
                Node: Operational | v1.0-Universal
            </div>
        </footer>
    </div>

</body>
</html>