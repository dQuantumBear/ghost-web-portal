        .bottom-bear:hover {
            filter: drop-shadow(0 0 8px var(--ghost-neon-green));
        }

        .highlight { color: var(--ghost-neon-green); font-weight: bold; }

        .footer-signature {
            font-size: 1.5em;
            margin-top: 20px;
            display: block;
        }

        footer {
            text-align: center;
            padding: 40px 20px;
            font-size: 0.8em;
            color: #777;
            background: #050505;
        }

        .signature-creator {
            opacity: 0;
            animation: fadeIn 0.5s ease-in 2.8s forwards;
        }

        .donate-btn {
            display: inline-block;
            padding: 14px 32px;
            margin: 10px 0;
            border: 2px solid var(--ghost-neon-green);
            color: var(--ghost-neon-green);
            background-color: transparent;
            text-decoration: none;
            font-weight: bold;
            letter-spacing: 2px;
            text-transform: uppercase;
            transition: 0.3s;
            border-radius: 4px;
            font-size: 0.95em;
            cursor: pointer;
            font-family: 'Courier New', Courier, monospace;
            white-space: nowrap;
        }

        .donate-btn:hover {
            background-color: var(--ghost-dark-green);
            color: var(--ghost-white);
            box-shadow: 0 0 20px var(--ghost-neon-green);
            transform: scale(1.02);
        }

        .donate-img {
            max-width: 100px;
            height: auto;
            display: block;
            margin: 0 auto;
            transition: 0.3s;
            filter: drop-shadow(0 0 8px var(--ghost-neon-green));
        }

        .donate-img:hover {
            transform: scale(1.08);
            filter: drop-shadow(0 0 16px var(--ghost-neon-green));
        }
    
        /* ===== STATEZER0 SLOT ENGINE ENHANCEMENTS ===== */
        :root {
            --box-size: 90px;
        }

        .slot-image {
            width: 92%;
            height: 92%;
            object-fit: contain;
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%) scale(0.5);
            opacity: 0;
            transition: all 0.55s cubic-bezier(0.34, 1.56, 0.64, 1);
            pointer-events: none;
            z-index: 2;
            filter: drop-shadow(0 0 0px transparent);
        }

        .letter-container.revealed .slot-image {
            opacity: 1;
            transform: translate(-50%, -50%) scale(1);
            filter: drop-shadow(0 0 12px var(--neon-green)) drop-shadow(0 0 28px rgba(57,255,20,0.45));
        }

        .letter-container.revealed .spinning-char {
            opacity: 0;
            transform: scale(0.7);
            transition: opacity 0.18s ease, transform 0.18s ease;
        }

        #title-container {
            min-height: calc(var(--box-size) + 35px);
            height: auto;
            padding: 10px 0;
        }

        @media (max-width: 900px) {
            :root { --box-size: clamp(38px, 9vw, 68px); }
            .spinning-char { font-size: clamp(26px, 6vw, 46px); }
            .row-container { gap: 4px; }
        }

        @media (max-width: 600px) {
            #title-container { min-height: 2.8em; font-size: 1.6em; }
        }

        @media (max-width: 480px) {
            :root { --box-size: clamp(32px, 10vw, 52px); }
            .spinning-char { font-size: clamp(20px, 7vw, 36px); }
            .row-container { gap: 2px; }
            #title-container { min-height: 2.5em; padding: 5px 0; }
        }

    </style>
