        box-shadow: 0 0 40px rgba(39, 174, 96, 0.5); animation: modalFadeIn 0.3s ease-out;
    }

    @keyframes modalFadeIn { from { opacity: 0; transform: scale(0.95); } to { opacity: 1; transform: scale(1); } }

    .modal-header { padding: 20px 25px 10px 25px; border-bottom: 1px solid var(--ghost-dark-green); display: flex; justify-content: space-between; align-items: center; }
