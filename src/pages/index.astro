<footer>
    <span class="footer-signature">🐻❤️M</span><br><br>
    &copy; 2026 Secure Messenger Project. Engineered for Privacy.
</footer>

<script>
    (function() {
        // TARGET TEXT - spells "SECURE MESSENGER"
        const FINAL_TEXT = "SECURE MESSENGER";
        // CHARACTER SET includes letters, numbers, AND symbols
        const SYMBOLS = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ!@#$%^&*()_+{}|:<>?~";
        
        const container = document.getElementById('the-slot-machine');
        if (!container) return;
        container.innerHTML = '';
        
        // Create ONE ROW wrapper
        const wrapper = document.createElement('div');
        wrapper.className = 'slot-machine-wrapper';
        const reelStrip = document.createElement('div');
        reelStrip.className = 'reel-strip';
        
        const reels = [];
        
        // Build each character container (ONE PER LETTER, arranged horizontally)
        for (let i = 0; i < FINAL_TEXT.length; i++) {
            const targetChar = FINAL_TEXT[i];
            
            // Add visual spacer for the space between "SECURE" and "MESSENGER"
            if (targetChar === ' ') {
                const spacer = document.createElement('div');
                spacer.className = 'spacer-block';
                reelStrip.appendChild(spacer);
                continue;
            }
            
            // Each container gets 35-60 random symbols stacked vertically
            const spinCount = 35 + Math.floor(Math.random() * 30);
            
            const reelDiv = document.createElement('div');
            reelDiv.className = 'reel';
            const innerDiv = document.createElement('div');
            innerDiv.className = 'reel-inner';
            
            // Add random characters (letters, numbers, symbols) - these will spin downwards
            for (let j = 0; j < spinCount; j++) {
                const span = document.createElement('div');
                span.className = 'reel-char';
                const randomSymbol = SYMBOLS[Math.floor(Math.random() * SYMBOLS.length)];
                span.textContent = randomSymbol;
                innerDiv.appendChild(span);
            }
            
            // Add the FINAL target character at the bottom
            const targetSpan = document.createElement('div');
            targetSpan.className = 'reel-char';
            targetSpan.textContent = targetChar;
            innerDiv.appendChild(targetSpan);
            
            reelDiv.appendChild(innerDiv);
            reelStrip.appendChild(reelDiv);
            
            reels.push({
                element: reelDiv,
                inner: innerDiv,
                totalItems: spinCount + 1,
                finalSpan: targetSpan,
                targetLetter: targetChar
            });
        }
        
        wrapper.appendChild(reelStrip);
        container.appendChild(wrapper);
        
        // Get accurate character height
        let charHeight = 95;
        if (reels.length && reels[0].inner.children[0]) {
            const sample = reels[0].inner.children[0];
            charHeight = sample.offsetHeight;
            if (charHeight < 20) charHeight = 95;
        }
        
        // TRIGGER NEON GREEN OUTBURST outward from all containers
        function triggerNeonOutburst() {
            // Flash each final character
            reels.forEach(reel => {
                const finalCharDiv = reel.inner.children[reel.inner.children.length - 1];
                if (finalCharDiv) {
                    finalCharDiv.classList.add('outburst-glow');
                }
                reel.element.classList.add('reel-flash');
                setTimeout(() => {
                    reel.element.classList.remove('reel-flash');
                }, 550);
            });
            // Flash the entire strip
            reelStrip.style.transition = 'box-shadow 0.2s, border-color 0.15s';
            reelStrip.style.boxShadow = '0 0 50px #39FF14, 0 0 90px #27AE60';
            reelStrip.style.borderColor = '#BFFF80';
            setTimeout(() => {
                reelStrip.style.boxShadow = '0 0 20px rgba(39, 174, 96, 0.5)';
                reelStrip.style.borderColor = 'var(--ghost-neon-green)';
            }, 700);
        }
        
        // SPIN ALL REELS DOWNWARDS with staggered timing
        let finishedAnimations = 0;
        const totalReels = reels.length;
        
        reels.forEach((reel, index) => {
            const distanceToMove = (reel.totalItems - 1) * charHeight;
            const spinDuration = 1800 + Math.random() * 1300;
            const startDelay = index * 55; // cascading wave effect
            
            setTimeout(() => {
                reel.inner.style.transition = `transform ${spinDuration}ms cubic-bezier(0.25, 0.94, 0.35, 1.05)`;
                reel.inner.style.transform = `translateY(-${distanceToMove}px)`;
                
                const finishTimer = setTimeout(() => {
                    finishedAnimations++;
                    if (finishedAnimations === totalReels) {
                        triggerNeonOutburst();
                    }
                }, spinDuration + 80);
                
                reel.inner.addEventListener('transitionend', function onEnd() {
                    clearTimeout(finishTimer);
                    finishedAnimations++;
                    if (finishedAnimations === totalReels) {
                        triggerNeonOutburst();
                    }
                    reel.inner.removeEventListener('transitionend', onEnd);
                }, { once: true });
                
            }, startDelay);
        });
        
        // Safety fallback
        const maxTotalDelay = (totalReels * 55) + 3200;
        setTimeout(() => {
            let allFinalFlashed = false;
            for(let r of reels) {
                const last = r.inner.children[r.inner.children.length-1];
                if(last && last.classList.contains('outburst-glow')) allFinalFlashed = true;
                else { allFinalFlashed = false; break; }
            }
            if (!allFinalFlashed && finishedAnimations !== totalReels) {
                triggerNeonOutburst();
            } else if (!allFinalFlashed && finishedAnimations === totalReels) {
                triggerNeonOutburst();
            }
        }, maxTotalDelay + 300);
        
        // Handle resize
        let resizeTimeout;
        window.addEventListener('resize', () => {
            clearTimeout(resizeTimeout);
            resizeTimeout = setTimeout(() => {
                const newCharHeight = document.querySelector('.reel-char')?.offsetHeight;
                if (newCharHeight && Math.abs(newCharHeight - charHeight) > 3) {
                    reels.forEach(reel => {
                        const currentTransform = reel.inner.style.transform;
                        if (currentTransform && currentTransform !== 'none') {
                            const newDistance = (reel.totalItems - 1) * newCharHeight;
                            reel.inner.style.transform = `translateY(-${newDistance}px)`;
                        }
                    });
                    charHeight = newCharHeight;
                }
            }, 100);
        });
    })();

    // MODAL FUNCTIONALITY (unaltered)
    const cookieModal = document.getElementById('cookieModal');
    const impressumModal = document.getElementById('impressumModal');
    const cookiePolicyLink = document.getElementById('cookiePolicyLink');
    const impressumLink = document.getElementById('impressumLink');
    const closeCookieBtn = document.getElementById('closeCookieModalBtn');
    const closeImpressumBtn = document.getElementById('closeImpressumModalBtn');
    const closeImpressumAcceptBtn = document.getElementById('closeImpressumAcceptBtn');
    
    function openCookieModal() { if(cookieModal){cookieModal.style.display='flex';document.body.style.overflow='hidden';} }
    function closeCookieModal() { if(cookieModal){cookieModal.style.display='none';document.body.style.overflow='';} }
    function openImpressumModal() { if(impressumModal){impressumModal.style.display='flex';document.body.style.overflow='hidden';} }
    function closeImpressumModal() { if(impressumModal){impressumModal.style.display='none';document.body.style.overflow='';} }
    
    if(cookiePolicyLink) cookiePolicyLink.onclick = (e) => { e.preventDefault(); openCookieModal(); };
    if(impressumLink) impressumLink.onclick = (e) => { e.preventDefault(); openImpressumModal(); };
    if(closeCookieBtn) closeCookieBtn.onclick = closeCookieModal;
    if(closeImpressumBtn) closeImpressumBtn.onclick = closeImpressumModal;
    if(closeImpressumAcceptBtn) closeImpressumAcceptBtn.onclick = closeImpressumModal;
    
    const acceptCookie = document.getElementById('acceptCookieBtn');
    if(acceptCookie) acceptCookie.onclick = () => { closeCookieModal(); localStorage.setItem('cookiePolicyAccepted', 'true'); };
    
    window.onclick = (e) => { if(e.target === cookieModal) closeCookieModal(); if(e.target === impressumModal) closeImpressumModal(); };
</script>
</body>
</html>
