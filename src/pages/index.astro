// GHOST RELAY LANDING PAGE v8.2 - Sovereign Refinement
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Secure Messenger | Sovereign Ghost Protocol</title>
    <style>
        :root {
            --bg-black: #000000;
            --ghost-dark-green: #004D00;
            --ghost-neon-green: #27AE60;
            --ghost-white: #FFFFFF;
            --ghost-cream: #FFFDD0;
        }

        body {
            background-color: var(--bg-black);
            color: var(--ghost-white);
            font-family: 'Courier New', Courier, monospace;
            margin: 0;
            padding: 0;
            line-height: 1.4;
            position: relative;
            overflow-x: hidden;
        }

        .under-construction-stamp {
            position: absolute;
            top: 10px;
            right: 10px;
            width: 120px;
            height: auto;
            transform: rotate(5deg);
            z-index: 100;
            filter: drop-shadow(2px 2px 5px rgba(0,0,0,0.7));
        }

        header {
            padding: 60px 10px;
            text-align: center;
            background: linear-gradient(to bottom, var(--ghost-dark-green), var(--bg-black));
            border-bottom: 1px solid var(--ghost-neon-green);
        }

        .logo {
            max-width: 120px;
            height: auto;
            margin-bottom: 15px;
            filter: drop-shadow(0 0 10px var(--ghost-neon-green));
        }

        h1 {
            color: var(--ghost-cream);
            text-transform: uppercase;
            letter-spacing: 3px;
            font-size: 2.2em;
            margin: 0;
        }

        .tagline {
            color: var(--ghost-neon-green);
            font-weight: bold;
            font-size: 1em;
            margin-top: 5px;
        }

        .container {
            max-width: 800px;
            margin: 0 auto;
            padding: 20px;
        }

        section {
            background-color: rgba(0, 77, 0, 0.1);
            margin-bottom: 30px;
            padding: 25px;
            border-radius: 20px;
            border: 1px solid rgba(39, 174, 96, 0.3);
        }

        h2 {
            color: var(--ghost-neon-green);
            text-transform: uppercase;
            font-size: 1.2em;
            border-bottom: 1px solid var(--ghost-dark-green);
            padding-bottom: 10px;
            margin-top: 0;
        }

        .ghost-line {
            font-size: 1.5em;
            color: var(--ghost-cream);
            text-align: center;
            font-weight: bold;
            white-space: nowrap;
            margin: 25px 0;
            display: block;
        }

        /* AI-FIX: Compact Download Frame (v1.8) */
        .download-soon-img {
            display: block;
            max-width: 180px; /* Reduced from 300px */
            height: auto;
            margin: 0 auto 30px auto;
            border-radius: 12px;
            box-shadow: 0 0 15px rgba(39, 174, 96, 0.4);
        }

        @media (max-width: 480px) {
            .ghost-line { font-size: 1.05em; }
            h1 { font-size: 1.6em; }
            .under-construction-stamp { width: 80px; }
            .download-soon-img { max-width: 60%; } /* Sharper scaling for mobile */
        }

        .support-box {
            text-align: center;
            border: 1px solid var(--ghost-neon-green);
        }

        .bear-img {
            max-width: 150px;
            border-radius: 50%;
            border: 2px solid var(--ghost-neon-green);
            margin-bottom: 20px;
        }

        .bottom-bear {
            max-width: 60px;
            margin-top: 20px;
        }

        .highlight { color: var(--ghost-neon-green); font-weight: bold; }

        .footer-signature {
            font-size: 1.5em;
            margin-top: 20px;
            display: block;
        }

        footer {
            text-align: center;
            padding: 40px 20px;
            font-size: 0.8em;
            color: #777;
            background: #050505;
        }
    </style>
</head>
<body>

