        <img src="/download_soon.png" alt="Download APK Soon" class="download-soon-img">
    </div>

    <footer>
        <span class="footer-signature">🐻❤️M</span><br><br>
        &copy; 2026 Secure Messenger Project. Engineered for Privacy.
    </footer>

    <script>
        (function() {
            const TEXT = "SECURE MESSENGER";
            const CHARS = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ!@#$%^&*()_+";
            const container = document.getElementById('slot-machine-area');
            const reels = [];
            
            // Create wrappers
            const wrapper = document.createElement('div');
            wrapper.className = 'slot-machine-container';
            const viewport = document.createElement('div');
            viewport.className = 'reel-viewport';
            
            // Build reels dynamically
            for (let i = 0; i < TEXT.length; i++) {
                const c = TEXT[i];
                
                if (c === ' ') {
                    const spacer = document.createElement('div');
                    spacer.className = 'space-holder';
                    viewport.appendChild(spacer);
                    continue;
                }
                
                const column = document.createElement('div');
                column.className = 'slot-column';
                const inner = document.createElement('div');
                inner.className = 'slot-column-inner';
                
                // Length determines the distance it spins down
                const reelLen = 40 + Math.floor(Math.random() * 20);
                
                for (let j = 0; j < reelLen - 1; j++) {
                    const span = document.createElement('span');
                    span.className = 'slot-char';
                    span.textContent = CHARS[Math.floor(Math.random() * CHARS.length)];
                    inner.appendChild(span);
                }
                
                // Final answer falling at the exact bottom of the row strip
                const targetSpan = document.createElement('span');
                targetSpan.className = 'slot-char';
                targetSpan.textContent = c;
                inner.appendChild(targetSpan);
                
                column.appendChild(inner);
                viewport.appendChild(column);
                
                reels.push({
                    element: inner,
                    length: reelLen
                });
            }
            
            wrapper.appendChild(viewport);
            container.appendChild(wrapper);
            
            // Wait for elements to register heights in DOM safely
            setTimeout(() => {
                let charH = 80; 
                if (window.innerWidth <= 768) {
                    charH = 44; // Sync responsive styles
                }
                
                let maxDuration = 0;

                reels.forEach((reel, idx) => {
                    const dist = (reel.length - 1) * charH;
                    // Staggered layout parameters for smooth sequential drops
                    const duration = 1500 + (idx * 120); 
                    const delay = 100;
                    
                    if ((duration + delay) > maxDuration) {
                        maxDuration = duration + delay;
                    }

                    setTimeout(() => {
                        reel.element.style.transition = `transform ${duration}ms cubic-bezier(0.1, 0.85, 0.25, 1.02)`;
                        reel.element.style.transform = `translateY(-${dist}px)`;
                    }, delay);
                });

                // Trigger Neon Explosion exactly as the last letter drops in place
                setTimeout(() => {
                    viewport.classList.add('glow-outburst');
                }, maxDuration);

            }, 50);
        })();

        // Modal initialization behavior
        const cookieModal = document.getElementById('cookieModal');
        const impressumModal = document.getElementById('impressumModal');
        const cookiePolicyLink = document.getElementById('cookiePolicyLink');
        const impressumLink = document.getElementById('impressumLink');
        const closeCookieBtn = document.getElementById('closeCookieModalBtn');
        const closeImpressumBtn = document.getElementById('closeImpressumModalBtn');
        const closeImpressumAcceptBtn = document.getElementById('closeImpressumAcceptBtn');

        function openCookieModal() { cookieModal.style.display = 'flex'; document.body.style.overflow = 'hidden'; }
        function closeCookieModal() { cookieModal.style.display = 'none'; document.body.style.overflow = ''; }
        function openImpressumModal() { impressumModal.style.display = 'flex'; document.body.style.overflow = 'hidden'; }
        function closeImpressumModal() { impressumModal.style.display = 'none'; document.body.style.overflow = ''; }

        if (cookiePolicyLink) cookiePolicyLink.addEventListener('click', (e) => { e.preventDefault(); openCookieModal(); });
        if (impressumLink) impressumLink.addEventListener('click', (e) => { e.preventDefault(); openImpressumModal(); });
        if (closeCookieBtn) closeCookieBtn.addEventListener('click', closeCookieModal);
        if (closeImpressumBtn) closeImpressumBtn.addEventListener('click', closeImpressumModal);
        if (closeImpressumAcceptBtn) closeImpressumAcceptBtn.addEventListener('click', closeImpressumModal);

        const acceptCookieBtn = document.getElementById('acceptCookieBtn');
        if (acceptCookieBtn) {
            acceptCookieBtn.addEventListener('click', () => {
                closeCookieModal();
                localStorage.setItem('cookiePolicyAccepted', 'true');
            });
        }

        window.addEventListener('click', (e) => {
            if (e.target === cookieModal) closeCookieModal();
            if (e.target === impressumModal) closeImpressumModal();
        });
    </script>
</body>
</html>
