    <script>
    (function() {
        'use strict';

        /* ============================================================
           STATEZER0 SLOT MACHINE ENGINE
           Target: "StateZer0" (9 characters)
           Images: s.png, t.png, a.png, e.png, z.png, r.png, 0.png
        ============================================================ */

        const TARGET = "StateZer0";
        const IMAGE_MAP = {
            'S': 's.png',
            't': 't.png',
            'a': 'a.png',
            'e': 'e.png',
            'Z': 'z.png',
            'r': 'r.png',
            '0': '0.png'
        };
        const CHARSET = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789@#$%&*!?";
        const SPIN_SPEED = 45;
        const REVEAL_START_DELAY = 900;
        const REVEAL_STAGGER = 240;
        const BURST_DELAY = 350;

        function initSlotMachine() {
            const mainRow = document.getElementById('main-row');
            const burst = document.getElementById('burst');
            if (!mainRow || !burst) return;

            burst.classList.remove('active');
            mainRow.innerHTML = '';
            mainRow.appendChild(burst);

            const slots = [];

            TARGET.split('').forEach((char, i) => {
                const container = document.createElement('div');
                container.className = 'letter-container';

                const spinChar = document.createElement('div');
                spinChar.className = 'spinning-char';
                spinChar.textContent = CHARSET[Math.floor(Math.random() * CHARSET.length)];
                spinChar.style.transform = 'translateY(0)';

                const img = document.createElement('img');
                img.className = 'slot-image';
                img.src = IMAGE_MAP[char];
                img.alt = char;
                img.draggable = false;

                container.appendChild(spinChar);
                container.appendChild(img);
                mainRow.insertBefore(container, burst);

                slots.push({ container, spinChar, char, index: i });
            });

            const spinTimer = setInterval(() => {
                slots.forEach(slot => {
                    if (!slot.container.classList.contains('revealed')) {
                        slot.spinChar.textContent = CHARSET[Math.floor(Math.random() * CHARSET.length)];
                        const jitter = (Math.random() * 20) - 10;
                        slot.spinChar.style.transform = `translateY(${jitter}px)`;
                    }
                });
            }, SPIN_SPEED);

            slots.forEach((slot, i) => {
                setTimeout(() => {
                    slot.container.classList.add('revealed');
                    slot.spinChar.style.transform = 'translateY(0)';
                    if (i === slots.length - 1) {
                        setTimeout(() => {
                            burst.classList.add('active');
                        }, BURST_DELAY);
                    }
                }, REVEAL_START_DELAY + (i * REVEAL_STAGGER));
            });

            const totalTime = REVEAL_START_DELAY + (slots.length * REVEAL_STAGGER) + BURST_DELAY + 500;
            setTimeout(() => {
                clearInterval(spinTimer);
            }, totalTime);
        }

        function setupModals() {
            const cookieModal = document.getElementById('cookieModal');
            const impressumModal = document.getElementById('impressumModal');

            document.getElementById('cookiePolicyLink')?.addEventListener('click', (e) => {
                e.preventDefault();
                cookieModal.style.display = 'flex';
            });
            document.getElementById('impressumLink')?.addEventListener('click', (e) => {
                e.preventDefault();
                impressumModal.style.display = 'flex';
            });

            ['closeCookieModalBtn', 'acceptCookieBtn'].forEach(id => {
                document.getElementById(id)?.addEventListener('click', () => {
                    cookieModal.style.display = 'none';
                });
            });
            ['closeImpressumModalBtn', 'closeImpressumAcceptBtn'].forEach(id => {
                document.getElementById(id)?.addEventListener('click', () => {
                    impressumModal.style.display = 'none';
                });
            });

            document.querySelectorAll('.modal-overlay').forEach(overlay => {
                overlay.addEventListener('click', (e) => {
                    if (e.target === overlay) overlay.style.display = 'none';
                });
            });
        }

        function setupMenu() {
            const menuContainer = document.querySelector('.menu-container');
            const menuIcon = document.querySelector('.menu-icon');
            const dropdown = menuContainer?.querySelector('.dropdown-content');
            if (!menuContainer || !menuIcon || !dropdown) return;

            let open = false;
            menuIcon.addEventListener('click', (e) => {
                e.stopPropagation();
                open = !open;
                dropdown.style.display = open ? 'block' : 'none';
            });
            document.addEventListener('click', (e) => {
                if (!menuContainer.contains(e.target)) {
                    open = false;
                    dropdown.style.display = 'none';
                }
            });
            menuContainer.addEventListener('mouseenter', () => {
                if (window.innerWidth > 768) dropdown.style.display = 'block';
            });
            menuContainer.addEventListener('mouseleave', () => {
                if (window.innerWidth > 768) dropdown.style.display = 'none';
            });
        }

        function setupReplay() {
            const titleContainer = document.getElementById('title-container');
            if (titleContainer) {
                titleContainer.addEventListener('click', () => {
                    initSlotMachine();
                });
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            initSlotMachine();
            setupModals();
            setupMenu();
            setupReplay();
        });
    })();
    </script>
