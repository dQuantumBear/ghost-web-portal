        :root {
            --bg-black: #000000;
            --ghost-dark-green: #004D00;
            --ghost-neon-green: #27AE60;
            --ghost-white: #FFFFFF;
            --ghost-cream: #FFFDD0;
        }

        body {
            background-color: var(--bg-black);
            color: var(--ghost-white);
            font-family: 'Courier New', Courier, monospace;
            margin: 0;
            padding: 0;
            line-height: 1.4;
            position: relative;
            overflow-x: hidden;
        }

        /* AI-FIX: Secure Menu Navigation (v8.2.2) */
        .menu-container {
            position: absolute;
            top: 20px;
            right: 20px;
            z-index: 1000;
        }

        .menu-icon {
            width: 50px;
            height: auto;
            cursor: pointer;
            filter: drop-shadow(0 0 5px var(--ghost-neon-green));
            transition: 0.3s;
        }

        .menu-icon:hover {
            transform: scale(1.1);
        }

        .dropdown-content {
            display: none;
            position: absolute;
            right: 0;
            top: 100%;
            background-color: var(--bg-black);
            min-width: 240px;
            border: 2px solid var(--ghost-neon-green);
            border-radius: 8px;
            box-shadow: 0 0 20px rgba(39, 174, 96, 0.4);
            padding: 10px 0;
            z-index: 1001;
        }

        .menu-container:hover .dropdown-content {
            display: block;
        }

        .dropdown-content a {
            color: var(--ghost-white);
            padding: 12px 20px;
            text-decoration: none;
            display: block;
            font-size: 0.9em;
            text-transform: uppercase;
            font-weight: bold;
            transition: 0.2s;
            border-bottom: 1px solid rgba(39, 174, 96, 0.1);
        }

        .dropdown-content a:last-child {
            border-bottom: none;
        }

        .dropdown-content a:hover {
            background-color: var(--ghost-dark-green);
            color: var(--ghost-neon-green);
        }

        header {
            padding: 60px 10px;
            text-align: center;
            background: linear-gradient(to bottom, var(--ghost-dark-green), var(--bg-black));
            border-bottom: 1px solid var(--ghost-neon-green);
        }

        .logo {
            max-width: 120px;
            height: auto;
            margin-bottom: 15px;
            filter: drop-shadow(0 0 10px var(--ghost-neon-green));
        }

        h1 {
            color: var(--ghost-cream);
            text-transform: uppercase;
            letter-spacing: 3px;
            font-size: 2.2em;
            margin: 0;
        }

        .tagline {
            color: var(--ghost-neon-green);
            font-weight: bold;
            font-size: 1em;
            margin-top: 5px;
        }

        /* Button Styling */
        .ghost-btn {
            display: inline-block;
            padding: 12px 24px;
            margin-top: 25px;
            border: 2px solid var(--ghost-neon-green);
            color: var(--ghost-neon-green);
            text-decoration: none;
            font-weight: bold;
            letter-spacing: 2px;
            transition: 0.3s;
            border-radius: 4px;
            font-size: 0.9em;
        }

        .ghost-btn:hover {
            background-color: var(--ghost-dark-green);
            color: var(--ghost-white);
            box-shadow: 0 0 15px var(--ghost-neon-green);
        }

        .container {
            max-width: 800px;
            margin: 0 auto;
            padding: 20px;
        }

        section {
            background-color: rgba(0, 77, 0, 0.1);
            margin-bottom: 30px;
            padding: 25px;
            border-radius: 20px;
            border: 1px solid rgba(39, 174, 96, 0.3);
        }

        h2 {
            color: var(--ghost-neon-green);
            text-transform: uppercase;
            font-size: 1.2em;
            border-bottom: 1px solid var(--ghost-dark-green);
            padding-bottom: 10px;
            margin-top: 0;
        }

        .ghost-line {
            font-size: 1.5em;
            color: var(--ghost-cream);
            text-align: center;
            font-weight: bold;
            white-space: nowrap;
            margin: 25px 0;
            display: block;
        }

        .download-soon-img {
            display: block;
            max-width: 180px;
            height: auto;
            margin: 0 auto 30px auto;
            border-radius: 12px;
            box-shadow: 0 0 15px rgba(39, 174, 96, 0.4);
        }

        @media (max-width: 480px) {
            .ghost-line { font-size: 1.05em; }
            h1 { font-size: 1.6em; }
            .download-soon-img { max-width: 60%; }
            .dropdown-content { right: -10px; min-width: 200px; }
        }

        .support-box {
            text-align: center;
            border: 1px solid var(--ghost-neon-green);
        }

        .bear-img {
            max-width: 150px;
            border-radius: 50%;
            border: 2px solid var(--ghost-neon-green);
            margin-bottom: 20px;
        }

        .bottom-bear {
            max-width: 60px;
            margin-top: 20px;
        }

        .highlight { color: var(--ghost-neon-green); font-weight: bold; }

        .footer-signature {
            font-size: 1.5em;
            margin-top: 20px;
            display: block;
        }

        footer {
            text-align: center;
            padding: 40px 20px;
            font-size: 0.8em;
            color: #777;
            background: #050505;
        }
