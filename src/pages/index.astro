    <script>
        // Get modal elements
        const cookieModal = document.getElementById('cookieModal');
        const impressumModal = document.getElementById('impressumModal');
        
        // Get menu links
        const cookiePolicyLink = document.getElementById('cookiePolicyLink');
        const impressumLink = document.getElementById('impressumLink');
        
        // Get close buttons
        const closeCookieBtn = document.getElementById('closeCookieModalBtn');
        const closeImpressumBtn = document.getElementById('closeImpressumModalBtn');
        const closeImpressumAcceptBtn = document.getElementById('closeImpressumAcceptBtn');
        
        // Cookie Policy functions
        function openCookieModal() {
            cookieModal.style.display = 'flex';
            document.body.style.overflow = 'hidden';
        }
        
        function closeCookieModal() {
            cookieModal.style.display = 'none';
            document.body.style.overflow = '';
        }
        
        // Impressum functions
        function openImpressumModal() {
            impressumModal.style.display = 'flex';
            document.body.style.overflow = 'hidden';
        }
        
        function closeImpressumModal() {
            impressumModal.style.display = 'none';
            document.body.style.overflow = '';
        }
        
        // Event listeners for menu links
        if (cookiePolicyLink) {
            cookiePolicyLink.addEventListener('click', function(e) {
                e.preventDefault();
                openCookieModal();
            });
        }
        
        if (impressumLink) {
            impressumLink.addEventListener('click', function(e) {
                e.preventDefault();
                openImpressumModal();
            });
        }
        
        // Event listeners for close buttons
        if (closeCookieBtn) {
            closeCookieBtn.addEventListener('click', closeCookieModal);
        }
        
        if (closeImpressumBtn) {
            closeImpressumBtn.addEventListener('click', closeImpressumModal);
        }
        
        if (closeImpressumAcceptBtn) {
            closeImpressumAcceptBtn.addEventListener('click', closeImpressumModal);
        }
        
        // Accept cookie button functionality
        const acceptCookieBtn = document.getElementById('acceptCookieBtn');
        if (acceptCookieBtn) {
            acceptCookieBtn.addEventListener('click', function() {
                closeCookieModal();
                // Store acceptance in localStorage
                localStorage.setItem('cookiePolicyAccepted', 'true');
                // Show a brief confirmation message
                const confirmation = document.createElement('div');
                confirmation.textContent = '✓ Cookie policy accepted';
                confirmation.style.cssText = `
                    position: fixed;
                    bottom: 20px;
                    right: 20px;
                    background-color: var(--ghost-dark-green);
                    color: var(--ghost-white);
                    padding: 10px 20px;
                    border-radius: 8px;
                    border: 1px solid var(--ghost-neon-green);
                    z-index: 2001;
                    font-family: monospace;
                    animation: fadeOut 2s forwards;
                `;
                document.body.appendChild(confirmation);
                setTimeout(() => confirmation.remove(), 2000);
            });
        }
        
        // Close modal when clicking outside the content
        window.addEventListener('click', function(e) {
            if (e.target === cookieModal) {
                closeCookieModal();
            }
            if (e.target === impressumModal) {
                closeImpressumModal();
            }
        });
        
        // Close modal with Escape key
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                if (cookieModal.style.display === 'flex') {
                    closeCookieModal();
                }
                if (impressumModal.style.display === 'flex') {
                    closeImpressumModal();
                }
            }
        });
        
        // Animation for fade out
        const style = document.createElement('style');
        style.textContent = `
            @keyframes fadeOut {
                0% { opacity: 1; }
                70% { opacity: 1; }
                100% { opacity: 0; visibility: hidden; }
            }
        `;
        document.head.appendChild(style);
    </script>

