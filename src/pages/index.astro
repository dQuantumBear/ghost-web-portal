---
// StateZerØ Homepage — Astro Page Component v6
// Place sphere PNGs (s.png, t.png, a.png, e.png, z.png, r.png, 0.png) in public/
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>StateZer0 | White-Label Zero-Knowledge Encrypted Communications Platform</title>
    <style is:global>
        :root {
            --bg-black: #000000;
            --ghost-dark-green: #004D00;
            --ghost-neon-green: #27AE60;
            --ghost-white: #FFFFFF;
            --ghost-cream: #FFFDD0;
            --ghost-red: #FF0000;
            --ghost-dark-red: #8B0000;
        }

        html { scroll-behavior: smooth; }

        body {
            background-color: var(--bg-black);
            color: var(--ghost-white);
            font-family: 'Courier New', Courier, monospace;
            margin: 0;
            padding: 0;
            line-height: 1.4;
            position: relative;
            overflow-x: hidden;
            box-sizing: border-box;
        }

        *, *:before, *:after {
            box-sizing: inherit;
        }

        /* Modal Overlay - Floating Window */
        .modal-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background-color: rgba(0, 0, 0, 0.85);
            backdrop-filter: blur(8px);
            z-index: 2000;
            justify-content: center;
            align-items: center;
            padding: 20px;
            box-sizing: border-box;
        }

        .modal-content {
            position: relative;
            background-color: var(--bg-black);
            border: 2px solid var(--ghost-neon-green);
            border-radius: 16px;
            max-width: 500px;
            width: 90%;
            max-height: 80vh;
            overflow-y: auto;
            box-shadow: 0 0 40px rgba(39, 174, 96, 0.5);
            animation: modalFadeIn 0.3s ease-out;
            box-sizing: border-box;
            min-width: 0;
            overflow-wrap: break-word;
            word-break: break-word;
        }

        @keyframes modalFadeIn {
            from {
                opacity: 0;
                transform: scale(0.95);
            }
            to {
                opacity: 1;
                transform: scale(1);
            }
        }

        .modal-header {
            padding: 20px 25px 10px 25px;
            border-bottom: 1px solid var(--ghost-dark-green);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .modal-header h2 {
            margin: 0;
            color: var(--ghost-neon-green);
            text-transform: uppercase;
            font-size: 1.3em;
            border: none;
            padding: 0;
        }

        .close-modal {
            background: none;
            border: none;
            color: var(--ghost-neon-green);
            font-size: 28px;
            cursor: pointer;
            padding: 0;
            width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            transition: 0.2s;
            flex-shrink: 0;
        }

        .close-modal:hover {
            background-color: var(--ghost-dark-green);
            transform: scale(1.1);
        }

        .modal-body {
            padding: 20px 25px;
            font-size: 0.9em;
            line-height: 1.6;
            color: var(--ghost-cream);
            overflow-wrap: break-word;
            word-break: break-word;
        }

        .modal-body p {
            margin: 10px 0;
        }

        .modal-body code {
            background: rgba(39, 174, 96, 0.2);
            padding: 2px 6px;
            border-radius: 4px;
            font-family: monospace;
            color: var(--ghost-neon-green);
        }

        .accept-btn {
            display: block;
            width: 100%;
            padding: clamp(12px, 3vw, 14px);
            margin-top: 20px;
            background-color: transparent;
            border: 2px solid var(--ghost-neon-green);
            color: var(--ghost-neon-green);
            font-weight: bold;
            font-size: clamp(0.9em, 2.5vw, 1em);
            cursor: pointer;
            border-radius: 8px;
            transition: 0.3s;
            font-family: inherit;
        }

        .accept-btn:hover {
            background-color: var(--ghost-dark-green);
            color: var(--ghost-white);
            box-shadow: 0 0 15px var(--ghost-neon-green);
        }

        /* Secure Menu Navigation */
        .menu-container {
            position: absolute;
            top: 20px;
            right: 20px;
            z-index: 1000;
        }

        .menu-icon {
            width: clamp(42px, 8vw, 55px);
            height: auto;
            cursor: pointer;
            filter: drop-shadow(0 0 5px var(--ghost-neon-green));
            transition: 0.3s;
        }

        .menu-icon:hover { transform: scale(1.1); }

        .dropdown-content {
            display: none;
            position: absolute;
            right: 0;
            top: 100%;
            background-color: var(--bg-black);
            min-width: 240px;
            border: 2px solid var(--ghost-neon-green);
            border-radius: 8px;
            box-shadow: 0 0 20px rgba(39, 174, 96, 0.4);
            padding: 10px 0;
            z-index: 1001;
        }

        .menu-container:hover .dropdown-content { display: block; }

        .dropdown-content a {
            color: var(--ghost-white);
            padding: 12px 20px;
            text-decoration: none;
            display: block;
            font-size: 0.9em;
            text-transform: uppercase;
            font-weight: bold;
            transition: 0.2s;
            border-bottom: 1px solid rgba(39, 174, 96, 0.1);
            cursor: pointer;
        }

        .dropdown-content a:last-child { border-bottom: none; }

        .dropdown-content a:hover {
            background-color: var(--ghost-dark-green);
            color: var(--ghost-neon-green);
        }

        header {
            padding: 60px 10px;
            text-align: center;
            background: linear-gradient(to bottom, var(--ghost-dark-green), var(--bg-black));
            border-bottom: 1px solid var(--ghost-neon-green);
            overflow: hidden;
        }

        .logo {
            max-width: 120px;
            height: auto;
            margin-bottom: 15px;
            animation: redToGreenGlow 3s ease-in-out infinite;
            transition: transform 0.3s ease;
        }

        .logo:hover {
            transform: scale(1.05);
            animation: redToGreenGlowFast 1.5s ease-in-out infinite;
        }

        @keyframes redToGreenGlow {
            0% {
                filter: drop-shadow(0 0 5px #FF0000) drop-shadow(0 0 10px #FF0000);
                opacity: 1;
            }
            25% {
                filter: drop-shadow(0 0 15px #FF4500) drop-shadow(0 0 25px #FF4500);
                opacity: 0.95;
            }
            50% {
                filter: drop-shadow(0 0 20px #27AE60) drop-shadow(0 0 35px #27AE60);
                opacity: 1;
            }
            75% {
                filter: drop-shadow(0 0 15px #00FF00) drop-shadow(0 0 25px #00FF00);
                opacity: 0.95;
            }
            100% {
                filter: drop-shadow(0 0 5px #FF0000) drop-shadow(0 0 10px #FF0000);
                opacity: 1;
            }
        }

        @keyframes redToGreenGlowFast {
            0% {
                filter: drop-shadow(0 0 8px #FF0000) drop-shadow(0 0 15px #FF0000);
            }
            25% {
                filter: drop-shadow(0 0 20px #FF4500) drop-shadow(0 0 35px #FF4500);
            }
            50% {
                filter: drop-shadow(0 0 25px #27AE60) drop-shadow(0 0 45px #27AE60);
            }
            75% {
                filter: drop-shadow(0 0 20px #00FF00) drop-shadow(0 0 35px #00FF00);
            }
            100% {
                filter: drop-shadow(0 0 8px #FF0000) drop-shadow(0 0 15px #FF0000);
            }
        }

        /* ===== STATEZER0 SLOT ENGINE v6 — CLEAN SPHERES ===== */
        #slot-machine {
            display: flex;
            flex-direction: row;
            gap: 3px;
            justify-content: center;
            align-items: center;
            position: relative;
            padding: 15px 8px;
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
            scrollbar-width: none;
            max-width: 100%;
        }

        #slot-machine::-webkit-scrollbar {
            display: none;
        }

        .sz-slot {
            position: relative;
            display: inline-block;
            flex-shrink: 0;
            min-width: 0;
        }

        .sz-sphere {
            width: clamp(55px, 7vw, 90px);
            height: auto;
            display: block;
            opacity: 0;
            transform: scale(0.5);
            /* FIX: split transition — never animate filter in Firefox */
            transition: opacity 0.7s ease, transform 0.7s cubic-bezier(0.34, 1.56, 0.64, 1);
            will-change: transform, opacity;
        }

        .sz-sphere.visible {
            opacity: 1;
            transform: scale(1);
            filter: drop-shadow(0 0 12px #39ff14) drop-shadow(0 0 30px rgba(57,255,20,0.4));
        }

        .sz-chaos {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            font-size: clamp(40px, 5vw, 70px);
            font-weight: bold;
            color: #FFFDD0;
            font-family: 'Courier New', Courier, monospace;
            text-shadow: 0 0 10px rgba(255,255,255,0.3), 0 0 25px rgba(57,255,20,0.15);
            z-index: 2;
            pointer-events: none;
            transition: opacity 0.2s ease;
            white-space: nowrap;
        }

        .sz-burst {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 50;
            opacity: 0;
        }

        .sz-burst.active {
            animation: sz-neon-burst 0.9s ease-out forwards;
        }

        @keyframes sz-neon-burst {
            0% { opacity: 0; box-shadow: 0 0 0px 0px #39ff14; }
            30% { opacity: 1; box-shadow: 0 0 150px 70px #39ff14; }
            100% { opacity: 0; box-shadow: 0 0 300px 140px rgba(57, 255, 20, 0); }
        }

        @media (max-width: 900px) {
            .sz-sphere { width: clamp(42px, 7vw, 65px); }
            .sz-chaos { font-size: clamp(30px, 5vw, 50px); }
            #slot-machine { gap: 2px; padding: 12px 6px; }
        }

        @media (max-width: 600px) {
            .sz-sphere { width: clamp(32px, 8vw, 50px); }
            .sz-chaos { font-size: clamp(22px, 6vw, 38px); }
            #slot-machine { gap: 2px; padding: 10px 4px; }
        }

        @media (max-width: 480px) {
            .sz-sphere { width: clamp(26px, 8.5vw, 38px); }
            .sz-chaos { font-size: clamp(18px, 6.5vw, 28px); }
            #slot-machine { gap: 1px; padding: 8px 2px; }
        }

        /* FIX: removed contain:paint so Firefox doesn't clip the slot machine */
        #title-container {
            color: var(--ghost-cream);
            text-transform: uppercase;
            letter-spacing: 3px;
            font-size: 2.2em;
            margin: 0;
            min-height: 3.6em;
            height: auto;
            overflow: visible;
            position: relative;
            display: flex;
            justify-content: center;
            align-items: center;
            text-align: center;
            width: 100%;
            cursor: pointer;
            user-select: none;
            -webkit-tap-highlight-color: transparent;
            opacity: 0;
            animation: fadeInTitle 0.1s ease-out 0.1s forwards;
        }

        @keyframes fadeInTitle {
            to { opacity: 1; }
        }

        .tagline {
            color: var(--ghost-neon-green);
            font-weight: bold;
            font-size: clamp(0.75em, 2vw, 1em);
            margin-top: 5px;
            opacity: 0;
            animation: fadeIn 0.5s ease-in 2.5s forwards;
            max-width: 100%;
            display: inline-block;
            text-transform: uppercase;
            letter-spacing: 1px;
            line-height: 1.4;
            padding: 0 10px;
        }

        .mobile-break { display: none; }

        @keyframes fadeIn {
            to { opacity: 1; }
        }

        /* FIX: buttons scale UP on mobile for touch accessibility */
        .ghost-btn {
            display: inline-block;
            padding: clamp(12px, 2.5vw, 16px) clamp(22px, 4vw, 32px);
            margin-top: 25px;
            border: 2px solid var(--ghost-neon-green);
            color: var(--ghost-neon-green);
            text-decoration: none;
            font-weight: bold;
            letter-spacing: 2px;
            transition: 0.3s;
            border-radius: 4px;
            font-size: clamp(0.8rem, 2vw, 0.95rem);
            opacity: 0;
            animation: fadeIn 0.5s ease-in 2.8s forwards;
        }

        .ghost-btn:hover {
            background-color: var(--ghost-dark-green);
            color: var(--ghost-white);
            box-shadow: 0 0 15px var(--ghost-neon-green);
        }

        .download-soon-img {
            width: 100%;
            max-width: 200px;
            margin: 20px auto;
            display: block;
            transition: 0.3s;
        }

        .download-soon-img:hover {
            transform: scale(1.05);
            filter: drop-shadow(0 0 10px var(--ghost-neon-green));
        }

        .container {
            max-width: 800px;
            margin: 0 auto;
            padding: 20px;
        }

        section {
            background-color: rgba(0, 77, 0, 0.1);
            margin-bottom: 30px;
            padding: 25px;
            border-radius: 20px;
            border: 1px solid rgba(39, 174, 96, 0.3);
            transition: all 0.3s ease;
            box-shadow: 0 0 20px rgba(39, 174, 96, 0.3);
            opacity: 0;
            animation: fadeInUp 0.5s ease-out forwards;
            animation-delay: calc(2.5s + (var(--order, 0) * 0.1s));
        }

        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        section:nth-child(1) { --order: 1; }
        section:nth-child(2) { --order: 2; }
        section:nth-child(3) { --order: 3; }
        section:nth-child(4) { --order: 4; }
        section:nth-child(5) { --order: 5; }
        section:nth-child(6) { --order: 6; }
        section:nth-child(7) { --order: 7; }

        section:hover {
            box-shadow: 0 0 30px rgba(39, 174, 96, 0.5);
            border-color: rgba(39, 174, 96, 0.6);
        }

        h2 {
            color: var(--ghost-neon-green);
            text-transform: uppercase;
            font-size: 1.2em;
            border-bottom: 1px solid var(--ghost-dark-green);
            padding-bottom: 10px;
            margin-top: 0;
        }

        .ghost-line {
            font-size: clamp(1.05em, 3vw, 1.5em);
            color: var(--ghost-cream);
            text-align: center;
            font-weight: bold;
            white-space: nowrap;
            margin: 25px 0;
            display: block;
            opacity: 0;
            animation: fadeIn 0.5s ease-in 2.3s forwards;
        }

        .support-box {
            text-align: center;
            border: 1px solid var(--ghost-neon-green);
        }

        .bear-img {
            max-width: 150px;
            border-radius: 50%;
            border: 2px solid var(--ghost-neon-green);
            margin-bottom: 20px;
            transition: all 0.3s ease;
            box-shadow: 0 0 15px rgba(39, 174, 96, 0.3);
        }

        .bear-img:hover {
            box-shadow: 0 0 25px rgba(39, 174, 96, 0.6);
        }

        .bottom-bear {
            max-width: 60px;
            margin-top: 20px;
            transition: all 0.3s ease;
        }

        .bottom-bear:hover {
            filter: drop-shadow(0 0 8px var(--ghost-neon-green));
        }

        .highlight { color: var(--ghost-neon-green); font-weight: bold; }

        .footer-signature {
            font-size: 1.5em;
            margin-top: 20px;
            display: block;
        }

        footer {
            text-align: center;
            padding: 40px 20px;
            font-size: 0.8em;
            color: #777;
            background: #050505;
        }

        .signature-creator {
            opacity: 0;
            animation: fadeIn 0.5s ease-in 2.8s forwards;
            font-size: clamp(0.8em, 2vw, 0.9em);
        }

        .donate-btn {
            display: inline-block;
            padding: clamp(14px, 3vw, 18px) clamp(28px, 5vw, 40px);
            margin: 10px 0;
            border: 2px solid var(--ghost-neon-green);
            color: var(--ghost-neon-green);
            background-color: transparent;
            text-decoration: none;
            font-weight: bold;
            letter-spacing: 2px;
            text-transform: uppercase;
            transition: 0.3s;
            border-radius: 4px;
            font-size: clamp(0.9rem, 2.2vw, 1.05rem);
            cursor: pointer;
            font-family: 'Courier New', Courier, monospace;
            white-space: nowrap;
        }

        .donate-btn:hover {
            background-color: var(--ghost-dark-green);
            color: var(--ghost-white);
            box-shadow: 0 0 20px var(--ghost-neon-green);
            transform: scale(1.02);
        }

        .donate-img {
            max-width: 100px;
            height: auto;
            display: block;
            margin: 0 auto;
            transition: 0.3s;
            filter: drop-shadow(0 0 8px var(--ghost-neon-green));
        }

        .donate-img:hover {
            transform: scale(1.08);
            filter: drop-shadow(0 0 16px var(--ghost-neon-green));
        }

        @media (max-width: 480px) {
            .mobile-break { display: block; height: 0; }
            .ghost-line { white-space: normal !important; margin: 15px 0; overflow-wrap: break-word; }
            section { padding: 15px; margin-bottom: 20px; border-radius: 12px; }
            h2 { font-size: 1.1em; }
            .download-soon-img { max-width: 180px; margin: 20px auto; }
            .dropdown-content { right: -10px; min-width: 200px; }
            .modal-overlay { padding: 10px; }
            .modal-content { width: 100%; max-width: 100%; }
            .logo { max-width: 80px; margin-bottom: 10px; }
            header { padding: 40px 10px; overflow-x: hidden; }
            body { font-size: 0.9em; }
            p, li { font-size: 0.9em; }
        }
    </style>
</head>
<body>
