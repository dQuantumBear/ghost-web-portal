/* ─── MODAL OVERLAY ─── */
.modal-overlay {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(8px);
    z-index: 2000;
    justify-content: center;
    align-items: center;
    padding: 20px;
}

/* ─── MODAL CONTENT ─── */
.modal-content {
    position: relative;
    background-color: var(--bg-black);
    border: 2px solid var(--ghost-neon-green);
    border-radius: 16px;
    max-width: 500px;
    width: 90%;
    max-height: 80vh;
    overflow-y: auto;
    box-shadow: 0 0 40px rgba(39, 174, 96, 0.5);
    animation: modalFadeIn 0.3s ease-out;
    /* REMOVED: margin: auto;  ← this was fighting flexbox centering */
}

.modal-body {
    padding: 20px 25px;
    font-size: 0.9em;
    line-height: 1.6;
    color: var(--ghost-cream);
    overflow-wrap: break-word;   /* prevents long emails/numbers from breaking layout */
    word-break: break-word;
}

/* ─── MOBILE FIX ─── */
@media (max-width: 480px) {
    .modal-content {
        width: calc(100% - 40px);  /* guarantees 20px breathing room each side */
        max-height: 90vh;
        /* REMOVED: margin: auto; */
    }
}
