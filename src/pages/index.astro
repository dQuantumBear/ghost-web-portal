<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>StateZerØ | White-Label Zero-Knowledge Encrypted Communications Platform</title>
    <style>
        :root {
            --bg-black: #000000;
            --ghost-dark-green: #004D00;
            --ghost-neon-green: #27AE60;
            --ghost-white: #FFFFFF;
            --ghost-cream: #FFFDD0;
            --ghost-red: #FF0000;
            --ghost-dark-red: #8B0000;
        }

        html { scroll-behavior: smooth; }

        body {
            background-color: var(--bg-black);
            color: var(--ghost-white);
            font-family: 'Courier New', Courier, monospace;
            margin: 0;
            padding: 0;
            line-height: 1.4;
            position: relative;
            overflow-x: hidden;
            box-sizing: border-box;
        }

        *, *:before, *:after {
            box-sizing: inherit;
        }

        /* Modal Overlay - Floating Window */
        .modal-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background-color: rgba(0, 0, 0, 0.85);
            backdrop-filter: blur(8px);
            z-index: 2000;
            justify-content: center;
            align-items: center;
            padding: 20px;
            box-sizing: border-box;
        }

        .modal-content {
            position: relative;
            background-color: var(--bg-black);
            border: 2px solid var(--ghost-neon-green);
            border-radius: 16px;
            max-width: 500px;
            width: 90%;
            max-height: 80vh;
            overflow-y: auto;
            box-shadow: 0 0 40px rgba(39, 174, 96, 0.5);
            animation: modalFadeIn 0.3s ease-out;
            box-sizing: border-box;
            min-width: 0;
            overflow-wrap: break-word;
            word-break: break-word;
        }

        @keyframes modalFadeIn {
            from {
                opacity: 0;
                transform: scale(0.95);
            }
            to {
                opacity: 1;
                transform: scale(1);
            }
        }

        .modal-header {
            padding: 20px 25px 10px 25px;
            border-bottom: 1px solid var(--ghost-dark-green);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .modal-header h2 {
            margin: 0;
            color: var(--ghost-neon-green);
            text-transform: uppercase;
            font-size: 1.3em;
            border: none;
            padding: 0;
        }

        .close-modal {
            background: none;
            border: none;
            color: var(--ghost-neon-green);
            font-size: 28px;
            cursor: pointer;
            padding: 0;
            width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            transition: 0.2s;
            flex-shrink: 0;
        }

        .close-modal:hover {
            background-color: var(--ghost-dark-green);
            transform: scale(1.1);
        }

        .modal-body {
            padding: 20px 25px;
            font-size: 0.9em;
            line-height: 1.6;
            color: var(--ghost-cream);
            overflow-wrap: break-word;
            word-break: break-word;
        }

        .modal-body p {
            margin: 10px 0;
        }

        .modal-body code {
            background: rgba(39, 174, 96, 0.2);
            padding: 2px 6px;
            border-radius: 4px;
            font-family: monospace;
            color: var(--ghost-neon-green);
        }

        .accept-btn {
            display: block;
            width: 100%;
            padding: 12px;
            margin-top: 20px;
            background-color: transparent;
            border: 2px solid var(--ghost-neon-green);
            color: var(--ghost-neon-green);
            font-weight: bold;
            font-size: 1em;
            cursor: pointer;
            border-radius: 8px;
            transition: 0.3s;
            font-family: inherit;
        }

        .accept-btn:hover {
            background-color: var(--ghost-dark-green);
            color: var(--ghost-white);
            box-shadow: 0 0 15px var(--ghost-neon-green);
        }

        /* AI-FIX: Secure Menu Navigation (v8.2.2) */
        .menu-container {
            position: absolute;
            top: 20px;
            right: 20px;
            z-index: 1000;
        }

        .menu-icon {
            width: 50px;
            height: auto;
            cursor: pointer;
            filter: drop-shadow(0 0 5px var(--ghost-neon-green));
            transition: 0.3s;
        }

        .menu-icon:hover { transform: scale(1.1); }

        .dropdown-content {
            display: none;
            position: absolute;
            right: 0;
            top: 100%;
            background-color: var(--bg-black);
            min-width: 240px;
            border: 2px solid var(--ghost-neon-green);
            border-radius: 8px;
            box-shadow: 0 0 20px rgba(39, 174, 96, 0.4);
            padding: 10px 0;
            z-index: 1001;
        }

        .menu-container:hover .dropdown-content { display: block; }

        .dropdown-content a {
            color: var(--ghost-white);
            padding: 12px 20px;
            text-decoration: none;
            display: block;
            font-size: 0.9em;
            text-transform: uppercase;
            font-weight: bold;
            transition: 0.2s;
            border-bottom: 1px solid rgba(39, 174, 96, 0.1);
            cursor: pointer;
        }

        .dropdown-content a:last-child { border-bottom: none; }

        .dropdown-content a:hover {
            background-color: var(--ghost-dark-green);
            color: var(--ghost-neon-green);
        }

        header {
            padding: 60px 10px;
            text-align: center;
            background: linear-gradient(to bottom, var(--ghost-dark-green), var(--bg-black));
            border-bottom: 1px solid var(--ghost-neon-green);
            overflow: hidden;
        }

        .logo {
            max-width: 120px;
            height: auto;
            margin-bottom: 15px;
            animation: redToGreenGlow 3s ease-in-out infinite;
            transition: transform 0.3s ease;
        }

        .logo:hover {
            transform: scale(1.05);
            animation: redToGreenGlowFast 1.5s ease-in-out infinite;
        }

        @keyframes redToGreenGlow {
            0% {
                filter: drop-shadow(0 0 5px #FF0000) drop-shadow(0 0 10px #FF0000);
                opacity: 1;
            }
            25% {
                filter: drop-shadow(0 0 15px #FF4500) drop-shadow(0 0 25px #FF4500);
                opacity: 0.95;
            }
            50% {
                filter: drop-shadow(0 0 20px #27AE60) drop-shadow(0 0 35px #27AE60);
                opacity: 1;
            }
            75% {
                filter: drop-shadow(0 0 15px #00FF00) drop-shadow(0 0 25px #00FF00);
                opacity: 0.95;
            }
            100% {
                filter: drop-shadow(0 0 5px #FF0000) drop-shadow(0 0 10px #FF0000);
                opacity: 1;
            }
        }

        @keyframes redToGreenGlowFast {
            0% {
                filter: drop-shadow(0 0 8px #FF0000) drop-shadow(0 0 15px #FF0000);
            }
            25% {
                filter: drop-shadow(0 0 20px #FF4500) drop-shadow(0 0 35px #FF4500);
            }
            50% {
                filter: drop-shadow(0 0 25px #27AE60) drop-shadow(0 0 45px #27AE60);
            }
            75% {
                filter: drop-shadow(0 0 20px #00FF00) drop-shadow(0 0 35px #00FF00);
            }
            100% {
                filter: drop-shadow(0 0 8px #FF0000) drop-shadow(0 0 15px #FF0000);
            }
        }

        /* Slot Engine */
        :root {
            --neon-green: #39ff14;
            --bg-color: #000;
            --container-bg: #111;
            --text-color: #fff;
            --box-size: 50px;
        }

        .row-container {
            display: flex;
            flex-direction: row;
            gap: 5px;
            position: relative;
            justify-content: center;
        }

        .letter-container {
            width: var(--box-size);
            height: var(--box-size);
            background-color: var(--container-bg);
            border: 1px solid #333;
            border-radius: 4px;
            overflow: hidden;
            position: relative;
            display: flex;
            justify-content: center;
            align-items: center;
            box-shadow: inset 0 0 10px rgba(0,0,0,0.8);
            flex-shrink: 0;
        }

        .spinning-char {
            font-size: 32px;
            font-weight: bold;
            color: var(--text-color);
            position: absolute;
            transition: transform 0.05s linear;
        }

        .letter-container.revealed .spinning-char {
            color: var(--neon-green);
            text-shadow: 0 0 10px var(--neon-green), 0 0 20px var(--neon-green);
            transform: translateY(0) !important;
        }

        .outburst-layer {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 100;
            opacity: 0;
        }

        .outburst-layer.active {
            animation: neon-burst 0.7s ease-out forwards;
        }

        @keyframes neon-burst {
            0% {
                opacity: 0;
                box-shadow: 0 0 0px 0px var(--neon-green);
            }
            30% {
                opacity: 1;
                box-shadow: 0 0 100px 50px var(--neon-green);
            }
            100% {
                opacity: 0;
                box-shadow: 0 0 200px 100px rgba(57, 255, 20, 0);
            }
        }

        @media (max-width: 900px) {
            :root {
                --box-size: clamp(8px, 3.6vw, 22px);
            }
            .spinning-char {
                font-size: clamp(6px, 2.8vw, 18px);
            }
            .row-container {
                gap: 0.15vw;
                flex-wrap: nowrap;
                letter-spacing: normal;
            }
        }

        @media (max-width: 600px) {
            #title-container {
                font-size: 1.15em;
                min-height: 2.0em;
            }
            .tagline { font-size: 0.75em !important; line-height: 1.4; }
        }

        #title-container {
            color: var(--ghost-cream);
            text-transform: uppercase;
            letter-spacing: 3px;
            font-size: 2.2em;
            margin: 0;
            height: 1.8em;
            overflow: visible !important;
            position: relative;
            display: flex;
            justify-content: center;
            align-items: center;
            text-align: center;
            contain: paint;
            min-height: 3.6em;
            visibility: visible;
            opacity: 0;
            animation: fadeInTitle 0.1s ease-out 0.1s forwards;
            width: 100%;
            cursor: pointer;
            user-select: none;
            -webkit-tap-highlight-color: transparent;
        }

        @keyframes fadeInTitle {
            to { opacity: 1; }
        }

        .tagline {
            color: var(--ghost-neon-green);
            font-weight: bold;
            font-size: 1em;
            margin-top: 5px;
            opacity: 0;
            animation: fadeIn 0.5s ease-in 2.5s forwards;
            max-width: 100%;
            display: inline-block;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .mobile-break { display: none; }

        @keyframes fadeIn {
            to { opacity: 1; }
        }

        .ghost-btn {
            display: inline-block;
            padding: 12px 24px;
            margin-top: 25px;
            border: 2px solid var(--ghost-neon-green);
            color: var(--ghost-neon-green);
            text-decoration: none;
            font-weight: bold;
            letter-spacing: 2px;
            transition: 0.3s;
            border-radius: 4px;
            font-size: 0.9em;
            opacity: 0;
            animation: fadeIn 0.5s ease-in 2.8s forwards;
        }

        .ghost-btn:hover {
            background-color: var(--ghost-dark-green);
            color: var(--ghost-white);
            box-shadow: 0 0 15px var(--ghost-neon-green);
        }

        .download-soon-img {
            width: 100%;
            max-width: 200px;
            margin: 20px auto;
            display: block;
            transition: 0.3s;
        }

        .download-soon-img:hover {
            transform: scale(1.05);
            filter: drop-shadow(0 0 10px var(--ghost-neon-green));
        }

        .container {
            max-width: 800px;
            margin: 0 auto;
            padding: 20px;
        }

        section {
            background-color: rgba(0, 77, 0, 0.1);
            margin-bottom: 30px;
            padding: 25px;
            border-radius: 20px;
            border: 1px solid rgba(39, 174, 96, 0.3);
            transition: all 0.3s ease;
            box-shadow: 0 0 20px rgba(39, 174, 96, 0.3);
            opacity: 0;
            animation: fadeInUp 0.5s ease-out forwards;
            animation-delay: calc(2.5s + (var(--order, 0) * 0.1s));
        }

        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        section:nth-child(1) { --order: 1; }
        section:nth-child(2) { --order: 2; }
        section:nth-child(3) { --order: 3; }
        section:nth-child(4) { --order: 4; }
        section:nth-child(5) { --order: 5; }
        section:nth-child(6) { --order: 6; }
        section:nth-child(7) { --order: 7; }

        section:hover {
            box-shadow: 0 0 30px rgba(39, 174, 96, 0.5);
            border-color: rgba(39, 174, 96, 0.6);
        }

        h2 {
            color: var(--ghost-neon-green);
            text-transform: uppercase;
            font-size: 1.2em;
            border-bottom: 1px solid var(--ghost-dark-green);
            padding-bottom: 10px;
            margin-top: 0;
        }

        .ghost-line {
            font-size: 1.5em;
            color: var(--ghost-cream);
            text-align: center;
            font-weight: bold;
            white-space: nowrap;
            margin: 25px 0;
            display: block;
            opacity: 0;
            animation: fadeIn 0.5s ease-in 2.3s forwards;
        }

        @media (max-width: 480px) {
            .mobile-break { display: block; height: 0; }
            .ghost-line { font-size: 1.05em; white-space: normal !important; margin: 15px 0; overflow-wrap: break-word; }
            section { padding: 15px; margin-bottom: 20px; border-radius: 12px; }
            h2 { font-size: 1.1em; }
            .download-soon-img { max-width: 180px; margin: 20px auto; }
            .dropdown-content { right: -10px; min-width: 200px; }
            .modal-overlay { padding: 10px; }
            .modal-content { width: 100%; max-width: 100%; }
            .logo { max-width: 80px; margin-bottom: 10px; }
            header { padding: 40px 10px; overflow-x: hidden; }
            .tagline { font-size: 0.75em !important; line-height: 1.4; }
            .ghost-btn { padding: 10px 20px; font-size: 0.8em; }
