<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <title>Secure Messenger | Sovereign Ghost Protocol</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --bg-black: #000000;
            --ghost-dark-green: #004D00;
            --ghost-neon-green: #27AE60;
            --ghost-white: #FFFFFF;
            --ghost-cream: #FFFDD0;
        }

        body {
            background-color: var(--bg-black);
            color: var(--ghost-white);
            font-family: 'Courier New', Courier, monospace;
            overflow-x: hidden;
        }

        /* Slot Machine - FORCED HORIZONTAL LAYOUT */
        .slot-wrapper {
            width: 100%;
            overflow-x: auto;
            overflow-y: hidden;
            text-align: center;
            padding: 20px 0;
        }

        .slot-container {
            display: block;
            white-space: nowrap;
            text-align: center;
        }

        .slot-reel {
            display: inline-block;
            vertical-align: top;
            width: 55px;
            height: 80px;
            overflow: hidden;
            position: relative;
            margin: 0 1px;
        }

        .slot-reel-inner {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            transition: transform 0ms linear;
        }

        .slot-char {
            display: block;
            width: 100%;
            height: 80px;
            line-height: 80px;
            text-align: center;
            font-size: 42px;
            font-weight: bold;
            color: var(--ghost-neon-green);
            text-shadow: 0 0 15px var(--ghost-neon-green);
            font-family: 'Courier New', Courier, monospace;
            white-space: nowrap;
        }

        .slot-spacer {
            display: inline-block;
            width: 25px;
        }

        /* Rest of your existing styles preserved */
        header {
            padding: 60px 10px;
            text-align: center;
            background: linear-gradient(to bottom, var(--ghost-dark-green), var(--bg-black));
            border-bottom: 1px solid var(--ghost-neon-green);
        }

        .logo {
            max-width: 120px;
            height: auto;
            margin-bottom: 15px;
            animation: redToGreenGlow 3s ease-in-out infinite;
        }

        @keyframes redToGreenGlow {
            0% { filter: drop-shadow(0 0 5px #FF0000) drop-shadow(0 0 10px #FF0000); }
            50% { filter: drop-shadow(0 0 20px #27AE60) drop-shadow(0 0 35px #27AE60); }
            100% { filter: drop-shadow(0 0 5px #FF0000) drop-shadow(0 0 10px #FF0000); }
        }

        .tagline {
            color: var(--ghost-neon-green);
            margin-top: 5px;
            opacity: 0;
            animation: fadeIn 0.5s ease-in 2.5s forwards;
        }

        .ghost-btn {
            display: inline-block;
            padding: 12px 24px;
            margin-top: 25px;
            border: 2px solid var(--ghost-neon-green);
            color: var(--ghost-neon-green);
            text-decoration: none;
            font-weight: bold;
            letter-spacing: 2px;
            transition: 0.3s;
            border-radius: 4px;
            opacity: 0;
            animation: fadeIn 0.5s ease-in 2.8s forwards;
        }

        .ghost-btn:hover {
            background-color: var(--ghost-dark-green);
            color: var(--ghost-white);
            box-shadow: 0 0 15px var(--ghost-neon-green);
        }

        .container {
            max-width: 800px;
            margin: 0 auto;
            padding: 20px;
        }

        section {
            background-color: rgba(0, 77, 0, 0.1);
            margin-bottom: 30px;
            padding: 25px;
            border-radius: 20px;
            border: 1px solid rgba(39, 174, 96, 0.3);
            box-shadow: 0 0 20px rgba(39, 174, 96, 0.3);
            opacity: 0;
            animation: fadeInUp 0.5s ease-out forwards;
            animation-delay: calc(2.5s + (var(--order, 0) * 0.1s));
        }

        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @keyframes fadeIn {
            to { opacity: 1; }
        }

        section:nth-child(1) { --order: 1; }
        section:nth-child(2) { --order: 2; }
        section:nth-child(3) { --order: 3; }
        section:nth-child(4) { --order: 4; }
        section:nth-child(5) { --order: 5; }
        section:nth-child(6) { --order: 6; }
        section:nth-child(7) { --order: 7; }

        h2 {
            color: var(--ghost-neon-green);
            text-transform: uppercase;
            font-size: 1.2em;
            border-bottom: 1px solid var(--ghost-dark-green);
            padding-bottom: 10px;
            margin-top: 0;
        }

        .ghost-line {
            font-size: 1.5em;
            color: var(--ghost-cream);
            text-align: center;
            font-weight: bold;
            margin: 25px 0;
            display: block;
            opacity: 0;
            animation: fadeIn 0.5s ease-in 2.3s forwards;
        }

        .highlight { color: var(--ghost-neon-green); font-weight: bold; }

        @media (max-width: 768px) {
            .slot-reel { width: 35px; height: 50px; }
            .slot-char { height: 50px; line-height: 50px; font-size: 26px; }
            .slot-spacer { width: 15px; }
        }

        @media (max-width: 480px) {
            .slot-reel { width: 28px; height: 40px; }
            .slot-char { height: 40px; line-height: 40px; font-size: 20px; }
            .slot-spacer { width: 10px; }
        }

        footer {
            text-align: center;
            padding: 40px 20px;
            font-size: 0.8em;
            color: #777;
            background: #050505;
        }
    </style>
</head>
<body>

    <header>
        <img src="/glass_logo.png" alt="Secure Messenger Logo" class="logo">
        <div id="slot-machine-area" style="min-height: 140px; margin: 20px 0;"></div>
        <p class="tagline">Sovereign Build v10.8.3 | The Architecture of Privacy</p>
        <div>
            <a href="#" class="ghost-btn">EXPLORE THE ARCHITECTURE</a>
        </div>
    </header>

    <div class="container">
        <span class="ghost-line">"To you, I am a conduit. To the world, you are a Ghost."</span>

        <section>
            <h2>1. Identity Sovereignty</h2>
            <p><b>The Advantage:</b> Unlike Signal or WhatsApp, SecureMessenger requires zero personal data.</p>
            <ul>
                <li><span class="highlight">Zero Identifiers:</span> No phone numbers, no SIM cards, and no email addresses.</li>
                <li><span class="highlight">Local Generation:</span> Your identity is a private 12-word cryptographic seed generated entirely on your device.</li>
                <li><span class="highlight">Total Ownership:</span> I do not store passwords. If you hold your 12 words, you hold your data.</li>
            </ul>
        </section>

        <section>
            <h2>2. The Blind Relay</h2>
            <p><b>The Advantage:</b> Traditional servers log IP addresses and timestamps. My "Blind Relay" doctrine makes the server a mere conduit.</p>
            <ul>
                <li><span class="highlight">IP Volatility:</span> Your IP address is processed in volatile RAM and instantly overwritten.</li>
                <li><span class="highlight">RAM-to-RAM Relay:</span> Messages exist on the server only until they reach the recipient.</li>
                <li><span class="highlight">Full-Spectrum Media Encryption:</span> All data is encrypted locally before upload.</li>
            </ul>
        </section>

        <section>
            <h2>3. Forensic Shredding</h2>
            <p><b>The Advantage:</b> Standard "deletion" leaves traces. SecureMessenger gives you a digital shredder.</p>
            <ul>
                <li><span class="highlight">Absolute Sovereignty:</span> You are the sole authority over your data.</li>
                <li><span class="highlight">Overwriting Protocol:</span> Data is overwritten with high-entropy noise before removal.</li>
                <li><span class="highlight">Hardware Armor:</span> Keys are isolated in your phone's Secure Element.</li>
            </ul>
        </section>

        <section>
            <h2>4. The Sovereign Handshake</h2>
            <p><b>The Advantage:</b> Stop discovery probing. You are invisible until you choose to be seen.</p>
            <ul>
                <li><span class="highlight">24-Hour Invites:</span> One-time temporary 6-digit codes.</li>
                <li><span class="highlight">Ghost Mode:</span> Freezes your status as "Offline" at the server level.</li>
                <li><span class="highlight">Quarantine Shield:</span> Blocked users don't know they've been quarantined.</li>
            </ul>
        </section>

        <section>
            <h2>5. Physical Sovereignty</h2>
            <p><b>The Advantage:</b> Security holds even if your device is seized.</p>
            <ul>
                <li><span class="highlight">The Panic PIN:</span> Triggers immediate "Nuclear Wipe" of all keys.</li>
                <li><span class="highlight">The 503 Alibi:</span> After wipe, displays "Network Error (503)".</li>
                <li><span class="highlight">Screen Armor:</span> Blocks screenshots and screen-recording.</li>
            </ul>
        </section>
    </div>

    <footer>
        &copy; 2026 Secure Messenger Project. Engineered for Privacy.
    </footer>

    <script>
        class SecureMessengerSlotMachine {
            constructor(targetText) {
                this.targetText = targetText.toUpperCase();
                this.reels = [];
                this.container = document.getElementById('slot-machine-area');
            }

            init() {
                this.container.innerHTML = '';
                
                const wrapper = document.createElement('div');
                wrapper.className = 'slot-wrapper';
                
                const container = document.createElement('div');
                container.className = 'slot-container';
                
                // Create one reel per character
                for (let i = 0; i < this.targetText.length; i++) {
                    const char = this.targetText[i];
                    
                    if (char === ' ') {
                        // Add spacer
                        const spacer = document.createElement('div');
                        spacer.className = 'slot-spacer';
                        container.appendChild(spacer);
                        continue;
                    }
                    
                    // Create reel container
                    const reel = document.createElement('div');
                    reel.className = 'slot-reel';
                    
                    const reelInner = document.createElement('div');
                    reelInner.className = 'slot-reel-inner';
                    
                    // Generate random characters (80-120)
                    const chars = "!@#$%^&*()_+1234567890ABCDEFGHIJKLMNOPQRSTUVWXYZ";
                    const reelLength = 80 + Math.floor(Math.random() * 40);
                    
                    // Add random characters
                    for (let j = 0; j < reelLength - 1; j++) {
                        const randomChar = chars[Math.floor(Math.random() * chars.length)];
                        const charDiv = document.createElement('div');
                        charDiv.className = 'slot-char';
                        charDiv.textContent = randomChar;
                        reelInner.appendChild(charDiv);
                    }
                    
                    // Add target character at the bottom
                    const targetDiv = document.createElement('div');
                    targetDiv.className = 'slot-char';
                    targetDiv.textContent = char;
                    reelInner.appendChild(targetDiv);
                    
                    reel.appendChild(reelInner);
                    container.appendChild(reel);
                    
                    this.reels.push({
                        element: reelInner,
                        length: reelLength,
                        char: char
                    });
                }
                
                wrapper.appendChild(container);
                this.container.appendChild(wrapper);
                
                // Start animation
                setTimeout(() => this.animate(), 100);
            }
            
            animate() {
                // Get character height
                let charHeight = 80;
                if (this.reels[0] && this.reels[0].element.children[0]) {
                    const h = this.reels[0].element.children[0].offsetHeight;
                    if (h && h > 0) charHeight = h;
                }
                
                // Animate each reel independently
                this.reels.forEach((reel, index) => {
                    const distance = (reel.length - 1) * charHeight;
                    const duration = 2500 + (Math.random() * 3000);
                    const delay = index * 50; // Staggered start
                    
                    reel.element.style.transition = `transform ${duration}ms cubic-bezier(0.2, 0.9, 0.4, 1) ${delay}ms`;
                    reel.element.style.transform = `translateY(-${distance}px)`;
                });
            }
        }

        // Start the slot machine when page loads
        document.addEventListener('DOMContentLoaded', () => {
            const slotMachine = new SecureMessengerSlotMachine("SECURE MESSENGER");
            slotMachine.init();
        });
    </script>
</body>
</html>
