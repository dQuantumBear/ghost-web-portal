    <title>Secure Messenger | Sovereign Ghost Protocol</title>
    <style>
        :root {
            --bg-black: #000000;
            --ghost-dark-green: #004D00;
            --ghost-neon-green: #27AE60;
            --ghost-white: #FFFFFF;
            --ghost-cream: #FFFDD0;
            --ghost-red: #FF0000;
            --ghost-dark-red: #8B0000;
        }

        html { scroll-behavior: smooth; }

        body {
            background-color: var(--bg-black);
            color: var(--ghost-white);
            font-family: 'Courier New', Courier, monospace;
            margin: 0;
            padding: 0;
            line-height: 1.4;
            position: relative;
            overflow-x: hidden;
        }

        /* Modal Overlay - Floating Window */
        .modal-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.85);
            backdrop-filter: blur(8px);
            z-index: 2000;
            justify-content: center;
            align-items: center;
        }

        .modal-content {
            position: relative;
            background-color: var(--bg-black);
            border: 2px solid var(--ghost-neon-green);
            border-radius: 16px;
            max-width: 500px;
            width: 90%;
            max-height: 80vh;
            overflow-y: auto;
            box-shadow: 0 0 40px rgba(39, 174, 96, 0.5);
            animation: modalFadeIn 0.3s ease-out;
        }

        @keyframes modalFadeIn {
            from {
                opacity: 0;
                transform: scale(0.95);
            }
            to {
                opacity: 1;
                transform: scale(1);
            }
        }

        .modal-header {
            padding: 20px 25px 10px 25px;
            border-bottom: 1px solid var(--ghost-dark-green);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .modal-header h2 {
            margin: 0;
            color: var(--ghost-neon-green);
            text-transform: uppercase;
            font-size: 1.3em;
            border: none;
            padding: 0;
        }

        .close-modal {
            background: none;
            border: none;
            color: var(--ghost-neon-green);
            font-size: 28px;
            cursor: pointer;
            padding: 0;
            width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            transition: 0.2s;
        }

        .close-modal:hover {
            background-color: var(--ghost-dark-green);
            transform: scale(1.1);
        }

        .modal-body {
            padding: 20px 25px;
            font-size: 0.9em;
            line-height: 1.6;
            color: var(--ghost-cream);
        }

        .modal-body p {
            margin: 10px 0;
        }

        .modal-body code {
            background: rgba(39, 174, 96, 0.2);
            padding: 2px 6px;
            border-radius: 4px;
            font-family: monospace;
            color: var(--ghost-neon-green);
        }

        .accept-btn {
            display: block;
            width: 100%;
            padding: 12px;
            margin-top: 20px;
            background-color: transparent;
            border: 2px solid var(--ghost-neon-green);
            color: var(--ghost-neon-green);
            font-weight: bold;
            font-size: 1em;
            cursor: pointer;
            border-radius: 8px;
            transition: 0.3s;
            font-family: inherit;
        }

        .accept-btn:hover {
            background-color: var(--ghost-dark-green);
            color: var(--ghost-white);
            box-shadow: 0 0 15px var(--ghost-neon-green);
        }

        /* AI-FIX: Secure Menu Navigation (v8.2.2) */
        .menu-container {
            position: absolute;
            top: 20px;
            right: 20px;
            z-index: 1000;
        }

        .menu-icon {
            width: 50px;
            height: auto;
            cursor: pointer;
            filter: drop-shadow(0 0 5px var(--ghost-neon-green));
            transition: 0.3s;
        }

        .menu-icon:hover { transform: scale(1.1); }

        .dropdown-content {
            display: none;
            position: absolute;
            right: 0;
            top: 100%;
            background-color: var(--bg-black);
            min-width: 240px;
            border: 2px solid var(--ghost-neon-green);
            border-radius: 8px;
            box-shadow: 0 0 20px rgba(39, 174, 96, 0.4);
            padding: 10px 0;
            z-index: 1001;
        }

        .menu-container:hover .dropdown-content { display: block; }

        .dropdown-content a {
            color: var(--ghost-white);
            padding: 12px 20px;
            text-decoration: none;
            display: block;
            font-size: 0.9em;
            text-transform: uppercase;
            font-weight: bold;
            transition: 0.2s;
            border-bottom: 1px solid rgba(39, 174, 96, 0.1);
            cursor: pointer;
        }

        .dropdown-content a:last-child { border-bottom: none; }

        .dropdown-content a:hover {
            background-color: var(--ghost-dark-green);
            color: var(--ghost-neon-green);
        }

        header {
            padding: 60px 10px;
            text-align: center;
            background: linear-gradient(to bottom, var(--ghost-dark-green), var(--bg-black));
            border-bottom: 1px solid var(--ghost-neon-green);
        }

        .logo {
            max-width: 120px;
            height: auto;
            margin-bottom: 15px;
            /* RED TO GREEN PULSING GLOW ANIMATION */
            animation: redToGreenGlow 3s ease-in-out infinite;
            transition: transform 0.3s ease;
        }

        .logo:hover {
            transform: scale(1.05);
            animation: redToGreenGlowFast 1.5s ease-in-out infinite;
        }

        /* Main animation: Red to Green pulsing glow */
        @keyframes redToGreenGlow {
            0% {
                filter: drop-shadow(0 0 5px #FF0000) drop-shadow(0 0 10px #FF0000);
                opacity: 1;
            }
            25% {
                filter: drop-shadow(0 0 15px #FF4500) drop-shadow(0 0 25px #FF4500);
                opacity: 0.95;
            }
            50% {
                filter: drop-shadow(0 0 20px #27AE60) drop-shadow(0 0 35px #27AE60);
                opacity: 1;
            }
            75% {
                filter: drop-shadow(0 0 15px #00FF00) drop-shadow(0 0 25px #00FF00);
                opacity: 0.95;
            }
            100% {
                filter: drop-shadow(0 0 5px #FF0000) drop-shadow(0 0 10px #FF0000);
                opacity: 1;
            }
        }

        /* Faster animation on hover for interactive feel */
        @keyframes redToGreenGlowFast {
            0% {
                filter: drop-shadow(0 0 8px #FF0000) drop-shadow(0 0 15px #FF0000);
            }
            25% {
                filter: drop-shadow(0 0 20px #FF4500) drop-shadow(0 0 35px #FF4500);
            }
            50% {
                filter: drop-shadow(0 0 25px #27AE60) drop-shadow(0 0 45px #27AE60);
            }
            75% {
                filter: drop-shadow(0 0 20px #00FF00) drop-shadow(0 0 35px #00FF00);
            }
            100% {
                filter: drop-shadow(0 0 8px #FF0000) drop-shadow(0 0 15px #FF0000);
            }
        }

        /* AI-FIX: Slot Machine Engine Styles (v17.3.0 - RECOVERY) */
        .slot-machine-container {
            position: relative;
            height: 1.8em;
            width: 100%;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden !important;
            contain: paint;
        }

        .reel-viewport {
            height: 1.8em;
            overflow: hidden !important;
            display: flex;
            justify-content: center;
            position: relative;
            width: 100%;
            mask-image: linear-gradient(to bottom, rgba(0,0,0,0.5) 0%, black 20%, black 80%, rgba(0,0,0,0.5) 100%);
            -webkit-mask-image: linear-gradient(to bottom, rgba(0,0,0,0.5) 0%, black 20%, black 80%, rgba(0,0,0,0.5) 100%);
            transform-style: flat;
            backface-visibility: hidden;
        }

        .slot-column {
            display: flex;
            flex-direction: column;
            width: 0.7em;
            text-align: center;
            will-change: transform;
            flex-shrink: 0;
        }

        .slot-char {
            display: block;
            height: 1.8em;
            line-height: 1.8em;
            color: var(--ghost-neon-green);
            text-shadow: 0 0 8px var(--ghost-neon-green);
            font-family: inherit;
        }

        .burst-layer {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            display: flex;
            justify-content: center;
            align-items: center;
            pointer-events: none;
            opacity: 0;
            color: var(--ghost-neon-green);
            text-shadow: 0 0 30px var(--ghost-neon-green);
            z-index: 10;
            white-space: nowrap;
        }

        @keyframes neonBurst {
            0% { opacity: 1; transform: scale(1); filter: blur(0px); }
            100% { opacity: 0; transform: scale(1.8); filter: blur(15px); }
