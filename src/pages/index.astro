---
// index.astro - SecureMessenger Landing Page v26.1.0-STABLE (GHOST-PHOENIX-VI)
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Secure Messenger | White Label Zero-Knowledge Encrypted Communications Platform</title>
    <style is:global>
        :root {
            --bg-black: #000000;
            --ghost-dark-green: #004D00;
            --ghost-neon-green: #27AE60;
            --ghost-white: #FFFFFF;
            --ghost-cream: #FFFDD0;
            --ghost-red: #FF0000;
            --ghost-dark-red: #8B0000;
            --neon-bright: #39ff14;
        }

        html { scroll-behavior: smooth; }

        body {
            background-color: var(--bg-black);
            color: var(--ghost-white);
            font-family: 'Courier New', Courier, monospace;
            margin: 0;
            padding: 0;
            line-height: 1.4;
            position: relative;
            overflow-x: hidden;
            box-sizing: border-box;
        }

        *, *:before, *:after { box-sizing: inherit; }

        /* Navigation Menu */
        .menu-container {
            position: absolute;
            top: 20px;
            right: 20px;
            z-index: 1000;
            cursor: pointer;
            padding: 10px;
        }

        .hamburger {
            width: 30px;
            height: 3px;
            background-color: var(--ghost-neon-green);
            position: relative;
            transition: 0.3s;
            box-shadow: 0 0 10px var(--ghost-neon-green);
        }

        .hamburger::before, .hamburger::after {
            content: '';
            position: absolute;
            width: 30px;
            height: 3px;
            background-color: var(--ghost-neon-green);
            transition: 0.3s;
            box-shadow: 0 0 10px var(--ghost-neon-green);
        }

        .hamburger::before { top: -10px; }
        .hamburger::after { top: 10px; }

        .menu-container:hover .hamburger, 
        .menu-container:hover .hamburger::before, 
        .menu-container:hover .hamburger::after { 
            background-color: var(--ghost-white); 
            box-shadow: 0 0 15px var(--ghost-white); 
        }

        .dropdown-content {
            display: none;
            position: absolute;
            right: 0;
            top: 100%;
            background-color: var(--bg-black);
            min-width: 240px;
            border: 2px solid var(--ghost-neon-green);
            border-radius: 8px;
            box-shadow: 0 0 20px rgba(39, 174, 96, 0.4);
            padding: 10px 0;
            z-index: 1001;
        }

        .menu-container:hover .dropdown-content { display: block; }

        .dropdown-content a {
            color: var(--ghost-white);
            padding: 12px 20px;
            text-decoration: none;
            display: block;
            font-size: 0.9em;
            text-transform: uppercase;
            font-weight: bold;
            transition: 0.2s;
            border-bottom: 1px solid rgba(39, 174, 96, 0.1);
        }

        .dropdown-content a:hover { background-color: var(--ghost-dark-green); color: var(--ghost-neon-green); }

        /* Modals */
        .modal-overlay {
            display: none;
            position: fixed;
            top: 0; left: 0;
            width: 100%; height: 100%;
            background-color: rgba(0, 0, 0, 0.85);
            backdrop-filter: blur(8px);
            z-index: 2000;
            justify-content: center;
            align-items: center;
        }

        .modal-content {
            background-color: var(--bg-black);
            border: 2px solid var(--ghost-neon-green);
            border-radius: 16px;
            max-width: 500px;
            width: 90%;
            padding: 20px;
            box-shadow: 0 0 40px rgba(39, 174, 96, 0.5);
        }

        .accept-btn { display: block; width: 100%; padding: 12px; margin-top: 20px; background-color: transparent; border: 2px solid var(--ghost-neon-green); color: var(--ghost-neon-green); font-weight: bold; cursor: pointer; border-radius: 8px; transition: 0.3s; }
        .accept-btn:hover { background-color: var(--ghost-dark-green); color: var(--ghost-white); }

        /* Header */
        header {
            padding: 60px 10px;
            text-align: center;
            background: linear-gradient(to bottom, var(--ghost-dark-green), var(--bg-black));
            border-bottom: 1px solid var(--ghost-neon-green);
        }

        .logo { max-width: 120px; margin-bottom: 15px; animation: redToGreenGlow 3s ease-in-out infinite; }

        @keyframes redToGreenGlow {
            0%, 100% { filter: drop-shadow(0 0 5px #FF0000); }
            50% { filter: drop-shadow(0 0 20px #27AE60); }
        }

        /* 17 Containers Slot Engine */
        .row-container { display: flex; gap: 5px; justify-content: center; margin: 20px 0; }
        .letter-container {
            width: 50px; height: 50px;
            background-color: #111;
            border: 1px solid #333;
            border-radius: 4px; overflow: hidden;
            position: relative; display: flex;
            justify-content: center; align-items: center;
        }

        .spinning-char { font-size: 32px; font-weight: bold; color: #fff; position: absolute; }
        .letter-container.revealed .spinning-char {
            color: var(--neon-bright);
            text-shadow: 0 0 10px var(--neon-bright);
            transform: translateY(0) !important;
        }

        /* Technical Components */
        .technical-component {
            width: 100%; margin: 40px 0; border: 1px solid var(--ghost-neon-green); border-radius: 8px;
            padding: 20px; background-color: rgba(0, 77, 0, 0.05); overflow-x: auto;
        }

        table { width: 100%; border-collapse: collapse; font-size: 0.85em; color: var(--ghost-cream); }
        th, td { text-align: left; padding: 12px; border-bottom: 1px solid rgba(39, 174, 96, 0.2); }
        th { color: var(--ghost-neon-green); text-transform: uppercase; }
        .highlight { color: var(--ghost-neon-green); font-weight: bold; }

        /* PayPal Button */
        .paypal-wrapper { margin: 25px 0; display: flex; justify-content: center; }
        .paypal-btn { 
            display: inline-block; transition: 0.3s; border-radius: 12px; overflow: hidden; 
            height: 56px; border: 1px solid rgba(39, 174, 96, 0.3); 
        }
        .paypal-btn:hover { transform: scale(1.05); box-shadow: 0 0 20px rgba(39, 174, 96, 0.4); border-color: var(--ghost-neon-green); }

        /* Multi-Language Styling */
        html[lang="de"] [lang="en"] { display: none; }
        html[lang="en"] [lang="de"] { display: none; }
        .lang-switch { position: absolute; top: 20px; left: 20px; z-index: 1000; }
        .lang-btn { cursor: pointer; padding: 5px 10px; border: 1px solid var(--ghost-neon-green); background: var(--bg-black); color: var(--ghost-neon-green); font-size: 0.8em; }
        .lang-btn.active { background: var(--ghost-neon-green); color: var(--bg-black); }

        footer { text-align: center; padding: 40px 20px; font-size: 0.8em; color: #777; background: #050505; }
        .footer-signature { font-size: 1.5em; margin-top: 20px; display: block; }
    </style>
</head>
<body>

    <div class="lang-switch">
        <span class="lang-btn" id="btn-en" onclick="setLang('en')">EN</span>
        <span class="lang-btn" id="btn-de" onclick="setLang('de')">DE</span>
    </div>

    <div class="menu-container">
        <div class="hamburger"></div>
        <div class="dropdown-content">
            <a href="https://glokta1991.github.io/legal-docs/privacy.html">Privacy Policy</a>
            <a href="https://glokta1991.github.io/legal-docs/manifesto.html">Manifesto</a>
            <a href="https://glokta1991.github.io/legal-docs/white_paper.html">White Paper</a>
            <a id="cookiePolicyLink">Cookie Policy</a>
            <a id="impressumLink">Impressum</a>
        </div>
    </div>

    <!-- Cookie Modal -->
    <div id="cookieModal" class="modal-overlay">
        <div class="modal-content">
            <h2 lang="en">Cookie Policy</h2><h2 lang="de">Cookie-Richtlinie</h2>
            <p lang="en">Status: Zero-Tracking Architecture active.</p>
            <p lang="de">Status: Zero-Tracking-Architektur aktiv.</p>
            <button id="acceptCookieBtn" class="accept-btn">✓ ACCEPT</button>
        </div>
    </div>

    <header>
        <img src="/glass_logo.png" alt="Secure Messenger Logo" class="logo">
        <div id="title-container" style="display: flex; justify-content: center; align-items: center; min-height: 80px;">
            <div class="row-container" id="main-row">
                <div class="outburst-layer" id="burst"></div>
            </div>
        </div>
        <p class="tagline">
            <span lang="en">v26.1.0-STABLE (GHOST-PHOENIX-VI) | White Label Zero-Knowledge Communications</span>
            <span lang="de">v26.1.0-STABLE (GHOST-PHOENIX-VI) | White-Label Zero-Knowledge Kommunikation</span>
        </p>
        <div style="margin-top: 20px;">
            <a href="https://glokta1991.github.io/legal-docs/white_paper.html" class="ghost-btn" style="text-decoration: none; border: 2px solid var(--ghost-neon-green); padding: 10px 20px; color: var(--ghost-neon-green); font-weight: bold;">EXPLORE THE ARCHITECTURE</a>
        </div>
    </header>

    <div class="container" style="max-width: 850px; margin: 0 auto; padding: 20px;">
        
        <section style="margin: 40px 0; text-align: center;">
            <p lang="en">"To you, I am a private bridge. To the world, you are a Ghost."</p>
            <p lang="de">„Für dich bin ich eine private Brücke. Für die Welt bist du ein Geist.“</p>
        </section>

        <div class="technical-component">
            <h3 lang="en">⚡ Feature Comparison</h3>
            <h3 lang="de">⚡ Feature-Vergleich</h3>
            <table>
                <thead>
                    <tr><th>Feature</th><th>Signal</th><th>SecureMessenger</th></tr>
                </thead>
                <tbody>
                    <tr><td>Identity</td><td>Phone Number</td><td class="highlight">Zero Identifiers (BIP39)</td></tr>
                    <tr><td>VoIP</td><td>Direct/P2P Sync</td><td class="highlight">RELAY_ONLY (No IP Leak)</td></tr>
                    <tr><td>Persistence</td><td>Standard Delete</td><td class="highlight">3-Pass Forensic Shredder</td></tr>
                </tbody>
            </table>
        </div>

        <section class="support-box" style="text-align: center; border: 1px solid var(--ghost-neon-green); padding: 40px; border-radius: 20px;">
            <img src="/bear_panic.png" alt="dQuantumBear" style="max-width: 150px; border-radius: 50%; border: 2px solid var(--ghost-neon-green);">
            <h2 lang="en">Built by One. Powered by You.</h2>
            <h2 lang="de">Gebaut von Einem. Angetrieben von Ihnen.</h2>
            
            <div class="paypal-wrapper">
                <a href="https://www.paypal.com/donate/?hosted_button_id=5BFMXH6TM5ZPN" target="_blank" class="paypal-btn">
                    <img src="/paypal.png" alt="Support with PayPal">
                </a>
            </div>
            
            <p class="highlight">Contact: securemessenger4U@proton.me</p>
            <p class="highlight">— dQuantumBear</p>
        </section>

    </div>

    <footer>
        <img src="/app_icon_bear.jpg" alt="Sovereign Bear" style="max-width: 60px;"><br>
        <span class="footer-signature">🐻❤️M</span><br><br>
        &copy; 2026 Secure Messenger Project. Engineered for Privacy.
    </footer>

    <script is:inline>
        // SLOT MACHINE LOGIC
        const targetStr = "SECURE MESSENGER "; 
        const charset = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%^&*()";
        const row = document.getElementById('main-row');
        const containers = [];

        for (let i = 0; i < 17; i++) {
            const container = document.createElement('div');
            container.className = 'letter-container';
            const charSpan = document.createElement('span');
            charSpan.className = 'spinning-char';
            charSpan.textContent = charset[0];
            container.appendChild(charSpan);
            row.appendChild(container);
            containers.push({ element: container, textNode: charSpan, target: targetStr[i], isRevealed: false });
        }

        function spin(index) {
            const c = containers[index];
            if (c.isRevealed) return;
            c.textNode.textContent = charset[Math.floor(Math.random() * charset.length)];
            setTimeout(() => spin(index), 70);
        }
        containers.forEach((_, i) => spin(i));

        setTimeout(() => {
            containers.forEach((c, i) => {
                setTimeout(() => {
                    c.isRevealed = true;
                    c.textNode.textContent = c.target;
                    c.element.classList.add('revealed');
                }, i * 150);
            });
        }, 3000);

        // LANGUAGE TOGGLE
        function setLang(lang) {
            document.documentElement.lang = lang;
            document.querySelectorAll('.lang-btn').forEach(b => b.classList.remove('active'));
            document.getElementById('btn-' + lang).classList.add('active');
            localStorage.setItem('preferred-lang', lang);
        }
        setLang(localStorage.getItem('preferred-lang') || 'en');

        // MODALS
        const cookieModal = document.getElementById('cookieModal');
        document.getElementById('cookiePolicyLink').onclick = () => cookieModal.style.display = 'flex';
        document.getElementById('acceptCookieBtn').onclick = () => cookieModal.style.display = 'none';
    </script>
</body>
</html>
