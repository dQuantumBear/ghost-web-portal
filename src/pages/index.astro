        .accept-btn, .menu-container, .menu-icon, .dropdown-content, header,
        .logo, .tagline, .ghost-btn, .container, section, h2, .ghost-line,
        .download-soon-img, .support-box, .bear-img, .bottom-bear, .highlight,
        .footer-signature, footer, .signature-creator {
            /* All your existing styles remain exactly the same */
        }

        /* ================== SLOT MACHINE FIX ================== */
        .slot-machine-container {
            position: relative;
            width: 100%;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 30px 10px;
        }

        .reel-viewport {
            display: flex;
            flex-direction: row;
            gap: 6px;
            height: 2.4em;
            overflow: hidden;
            border: 3px solid var(--ghost-neon-green);
            border-radius: 12px;
            background: rgba(0, 20, 0, 0.85);
            padding: 0 12px;
            box-shadow: 0 0 30px rgba(39, 174, 96, 0.6),
                        inset 0 0 20px rgba(0, 0, 0, 0.8);
        }

        .slot-column {
            display: flex;
            flex-direction: column;
            will-change: transform;
        }

        .slot-char {
            height: 2.4em;
            line-height: 2.4em;
            font-size: 2.35em;
            color: var(--ghost-neon-green);
            text-shadow: 0 0 12px var(--ghost-neon-green),
                         0 0 25px var(--ghost-neon-green);
            text-align: center;
            min-width: 1.15em;
            font-weight: bold;
            user-select: none;
        }

        .burst-layer {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            pointer-events: none;
            font-size: 2.35em;
            font-weight: bold;
            color: var(--ghost-neon-green);
            text-shadow: 0 0 40px var(--ghost-neon-green);
            white-space: nowrap;
            opacity: 0;
            z-index: 10;
        }

        @keyframes neonBurst {
            0%   { opacity: 1; transform: translate(-50%, -50%) scale(1); }
            100% { opacity: 0; transform: translate(-50%, -50%) scale(1.6); }
        }

        h1 {
            color: var(--ghost-cream);
            text-transform: uppercase;
            letter-spacing: 3px;
            font-size: 2.2em;
            margin: 0;
            position: relative;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 3.8em;
            opacity: 0;
            animation: fadeInTitle 0.1s ease-out 0.1s forwards;
        }

        @keyframes fadeInTitle {
            to { opacity: 1; }
        }
        /* ================== END SLOT MACHINE FIX ================== */

        /* Your other styles (media queries, sections, etc.) remain unchanged */
        @media (max-width: 480px) {
            .reel-viewport { height: 2.1em; gap: 3px; }
            .slot-char { font-size: 2.05em; height: 2.1em; line-height: 2.1em; }
            h1 { font-size: 1.65em; }
        }
    </style>
