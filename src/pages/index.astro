<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Secure Messenger | Sovereign Ghost Protocol</title>
    <style>
        :root {
            --bg-black: #000000;
            --ghost-dark-green: #004D00;
            --ghost-neon-green: #27AE60;
            --ghost-white: #FFFFFF;
            --ghost-cream: #FFFDD0;
            --ghost-red: #FF0000;
            --ghost-dark-red: #8B0000;
        }

        html { scroll-behavior: smooth; }

        body {
            background-color: var(--bg-black);
            color: var(--ghost-white);
            font-family: 'Courier New', Courier, monospace;
            margin: 0;
            padding: 0;
            line-height: 1.4;
            position: relative;
            overflow-x: hidden;
        }

        /* SLOT MACHINE STYLES */
        .slot-machine-container {
            display: flex;
            justify-content: center;
            align-items: center;
            margin: 40px auto;
            position: relative;
        }

        .reel-viewport {
            display: flex;
            flex-direction: row;
            justify-content: center;
            align-items: center;
            gap: 8px;
            background: rgba(0, 0, 0, 0.9);
            border: 3px solid var(--ghost-neon-green);
            border-radius: 12px;
            padding: 15px 25px;
            box-shadow: 0 0 30px rgba(39, 174, 96, 0.4);
            overflow: hidden;
            position: relative;
        }

        .reel-viewport.reveal {
            animation: reelGlowOutburst 0.8s ease-out;
        }

        @keyframes reelGlowOutburst {
            0% {
                box-shadow: 0 0 30px rgba(39, 174, 96, 0.4);
            }
            50% {
                box-shadow: 
                    0 0 80px rgba(39, 174, 96, 1),
                    0 0 120px rgba(39, 174, 96, 0.8),
                    inset 0 0 50px rgba(39, 174, 96, 0.4);
                border-color: #FFFF00;
            }
            100% {
                box-shadow: 
                    0 0 60px rgba(39, 174, 96, 0.7),
                    0 0 100px rgba(39, 174, 96, 0.4);
                border-color: var(--ghost-neon-green);
            }
        }

        .slot-column {
            display: block;
            width: 65px;
            height: 100px;
            overflow: hidden;
            position: relative;
            background: rgba(10, 10, 10, 0.95);
            border: 1px solid rgba(39, 174, 96, 0.5);
            border-radius: 6px;
            box-shadow: inset 0 0 10px rgba(0, 0, 0, 0.8);
        }

        .slot-column-inner {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            transition: none;
        }

        .slot-char {
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100px;
            width: 100%;
            font-size: 52px;
            font-weight: bold;
            color: var(--ghost-neon-green);
            text-shadow: 0 0 20px var(--ghost-neon-green);
            font-family: 'Courier New', Courier, monospace;
            letter-spacing: 2px;
        }

        /* Outburst particles */
        .outburst-particle {
            position: fixed;
            width: 10px;
            height: 10px;
            background: var(--ghost-neon-green);
            border-radius: 50%;
            pointer-events: none;
            box-shadow: 0 0 15px var(--ghost-neon-green);
            z-index: 999;
        }

        .outburst-particle.animate {
            animation: particleBurst 1s ease-out forwards;
        }

        @keyframes particleBurst {
            0% {
                opacity: 1;
                transform: translate(0, 0) scale(1);
            }
            100% {
                opacity: 0;
                transform: translate(var(--tx), var(--ty)) scale(0);
            }
        }

        /* Other elements */
        header {
            padding: 60px 10px;
            text-align: center;
            background: linear-gradient(to bottom, var(--ghost-dark-green), var(--bg-black));
            border-bottom: 1px solid var(--ghost-neon-green);
        }

        .logo {
            max-width: 120px;
            height: auto;
            margin-bottom: 15px;
            animation: redToGreenGlow 3s ease-in-out infinite;
        }

        @keyframes redToGreenGlow {
            0% { filter: drop-shadow(0 0 5px #FF0000) drop-shadow(0 0 10px #FF0000); }
            50% { filter: drop-shadow(0 0 20px #27AE60) drop-shadow(0 0 35px #27AE60); }
            100% { filter: drop-shadow(0 0 5px #FF0000) drop-shadow(0 0 10px #FF0000); }
        }

        .tagline {
            color: var(--ghost-neon-green);
            font-weight: bold;
            font-size: 1em;
            margin-top: 15px;
            opacity: 0;
        }

        .tagline.show {
            animation: fadeIn 0.5s ease-in forwards;
        }

        @keyframes fadeIn {
            to { opacity: 1; }
        }

        .ghost-btn {
            display: inline-block;
            padding: 12px 24px;
            margin-top: 25px;
            border: 2px solid var(--ghost-neon-green);
            color: var(--ghost-neon-green);
            text-decoration: none;
            font-weight: bold;
            letter-spacing: 2px;
            transition: 0.3s;
            border-radius: 4px;
            font-size: 0.9em;
            opacity: 0;
        }

        .ghost-btn.show {
            animation: fadeIn 0.5s ease-in forwards;
        }

        .ghost-btn:hover {
            background-color: var(--ghost-dark-green);
            color: var(--ghost-white);
            box-shadow: 0 0 15px var(--ghost-neon-green);
        }

        .container {
            max-width: 800px;
            margin: 0 auto;
            padding: 20px;
        }

        section {
            background-color: rgba(0, 77, 0, 0.1);
            margin-bottom: 30px;
            padding: 25px;
            border-radius: 20px;
            border: 1px solid rgba(39, 174, 96, 0.3);
            box-shadow: 0 0 20px rgba(39, 174, 96, 0.3);
            opacity: 0;
        }

        section.show {
            animation: fadeInUp 0.5s ease-out forwards;
        }

        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        h2 {
            color: var(--ghost-neon-green);
            text-transform: uppercase;
            font-size: 1.2em;
            border-bottom: 1px solid var(--ghost-dark-green);
            padding-bottom: 10px;
            margin-top: 0;
        }

        .ghost-line {
            font-size: 1.5em;
            color: var(--ghost-cream);
            text-align: center;
            font-weight: bold;
            margin: 25px 0;
            display: block;
            opacity: 0;
        }

        .ghost-line.show {
            animation: fadeIn 0.5s ease-in forwards;
        }

        .menu-container {
            position: absolute;
            top: 20px;
            right: 20px;
            z-index: 1000;
        }

        .menu-icon {
            width: 50px;
            height: auto;
            cursor: pointer;
            filter: drop-shadow(0 0 5px var(--ghost-neon-green));
            transition: 0.3s;
        }

        .menu-icon:hover { transform: scale(1.1); }

        .dropdown-content {
            display: none;
            position: absolute;
            right: 0;
            top: 100%;
            background-color: var(--bg-black);
            min-width: 240px;
            border: 2px solid var(--ghost-neon-green);
            border-radius: 8px;
            box-shadow: 0 0 20px rgba(39, 174, 96, 0.4);
            padding: 10px 0;
            z-index: 1001;
        }

        .menu-container:hover .dropdown-content { display: block; }

        .dropdown-content a {
            color: var(--ghost-white);
            padding: 12px 20px;
            text-decoration: none;
            display: block;
            font-size: 0.9em;
            text-transform: uppercase;
            font-weight: bold;
            transition: 0.2s;
            border-bottom: 1px solid rgba(39, 174, 96, 0.1);
            cursor: pointer;
        }

        .dropdown-content a:last-child { border-bottom: none; }

        .dropdown-content a:hover {
            background-color: var(--ghost-dark-green);
            color: var(--ghost-neon-green);
        }

        .modal-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.85);
            backdrop-filter: blur(8px);
            z-index: 2000;
            justify-content: center;
            align-items: center;
        }

        .modal-content {
            position: relative;
            background-color: var(--bg-black);
            border: 2px solid var(--ghost-neon-green);
            border-radius: 16px;
            max-width: 500px;
            width: 90%;
            max-height: 80vh;
            overflow-y: auto;
            box-shadow: 0 0 40px rgba(39, 174, 96, 0.5);
            animation: modalFadeIn 0.3s ease-out;
        }

        @keyframes modalFadeIn {
            from {
                opacity: 0;
                transform: scale(0.95);
            }
            to {
                opacity: 1;
                transform: scale(1);
            }
        }

        .modal-header {
            padding: 20px 25px 10px 25px;
            border-bottom: 1px solid var(--ghost-dark-green);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .modal-header h2 {
            margin: 0;
            color: var(--ghost-neon-green);
            text-transform: uppercase;
            font-size: 1.3em;
            border: none;
            padding: 0;
        }

        .close-modal {
            background: none;
            border: none;
            color: var(--ghost-neon-green);
            font-size: 28px;
            cursor: pointer;
            padding: 0;
            width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            transition: 0.2s;
        }

        .close-modal:hover {
            background-color: var(--ghost-dark-green);
            transform: scale(1.1);
        }

        .modal-body {
            padding: 20px 25px;
            font-size: 0.9em;
            line-height: 1.6;
            color: var(--ghost-cream);
        }

        .accept-btn {
            display: block;
            width: 100%;
            padding: 12px;
            margin-top: 20px;
            background-color: transparent;
            border: 2px solid var(--ghost-neon-green);
            color: var(--ghost-neon-green);
            font-weight: bold;
            font-size: 1em;
            cursor: pointer;
            border-radius: 8px;
            transition: 0.3s;
            font-family: inherit;
        }

        .accept-btn:hover {
            background-color: var(--ghost-dark-green);
            color: var(--ghost-white);
            box-shadow: 0 0 15px var(--ghost-neon-green);
        }

        .download-soon-img {
            display: block;
            margin: 50px auto;
            max-width: 320px;
            width: 90%;
            height: auto;
            filter: drop-shadow(0 0 15px rgba(39, 174, 96, 0.4));
        }

        .highlight { color: var(--ghost-neon-green); font-weight: bold; }

        footer {
            text-align: center;
            padding: 40px 20px;
            font-size: 0.8em;
            color: #777;
            background: #050505;
        }

        @media (max-width: 768px) {
            .slot-column { width: 45px; height: 70px; }
            .slot-char { height: 70px; font-size: 36px; }
            .reel-viewport { gap: 4px; padding: 10px 15px; }
        }
    </style>
</head>
<body>

    <div class="menu-container">
