    <script>
        (function() {
            const TARGET_TEXT = "SECURE MESSENGER";
            const SYMBOL_SET = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%^&*()_+{}|:<>?~";
            
            const container = document.getElementById('slot-machine-area');
            if (!container) return;
            
            // clear previous content if any
            container.innerHTML = '';
            
            // main wrapper and viewport
            const wrapper = document.createElement('div');
            wrapper.className = 'slot-machine-container';
            const viewport = document.createElement('div');
            viewport.className = 'reel-viewport';
            
            const reelsData = []; // store each reel { innerDiv, targetChar, finalIndex, totalSymbols }
            const columns = [];
            
            // Helper: generate random char from set
            function getRandomSymbol() {
                return SYMBOL_SET[Math.floor(Math.random() * SYMBOL_SET.length)];
            }
            
            // build each character column (including spaces as visual spacers)
            for (let i = 0; i < TARGET_TEXT.length; i++) {
                const targetChar = TARGET_TEXT[i];
                
                if (targetChar === ' ') {
                    const spacer = document.createElement('div');
                    spacer.className = 'space-holder';
                    viewport.appendChild(spacer);
                    columns.push({ type: 'spacer' });
                    continue;
                }
                
                // determine number of random symbols that will scroll (25 to 45 items for smooth heavy spin)
                const spinItemsCount = 28 + Math.floor(Math.random() * 22);  // 28-49 symbols before final char
                const columnDiv = document.createElement('div');
                columnDiv.className = 'slot-column';
                const innerDiv = document.createElement('div');
                innerDiv.className = 'slot-column-inner';
                
                // fill with random symbols + the final character at the bottom
                for (let j = 0; j < spinItemsCount; j++) {
                    const span = document.createElement('span');
                    span.className = 'slot-char';
                    span.textContent = getRandomSymbol();
                    innerDiv.appendChild(span);
                }
                // final character span (target)
                const finalSpan = document.createElement('span');
                finalSpan.className = 'slot-char';
                finalSpan.textContent = targetChar;
                innerDiv.appendChild(finalSpan);
                
                columnDiv.appendChild(innerDiv);
                viewport.appendChild(columnDiv);
                
                // store metadata
                reelsData.push({
                    inner: innerDiv,
                    targetChar: targetChar,
                    totalSymbols: spinItemsCount + 1,    // +1 for final target
                    element: columnDiv,
                    finalSpan: finalSpan
                });
            }
            
            wrapper.appendChild(viewport);
            container.appendChild(wrapper);
            
            // measure character height (using first column's first char)
            let charHeight = 85;
            if (reelsData.length > 0 && reelsData[0].inner.children[0]) {
                const firstSpan = reelsData[0].inner.children[0];
                charHeight = firstSpan.offsetHeight;
                if (charHeight === 0) charHeight = 85; // fallback
            }
            
            // For better responsiveness, also listen to resize? but simple.
            const finalizeAndFlash = () => {
                // apply outburst: flash neon green to all final characters inside slot columns
                reelsData.forEach(reel => {
                    const allChars = reel.inner.querySelectorAll('.slot-char');
                    if (allChars.length > 0) {
                        const bottomChar = allChars[allChars.length - 1];
                        bottomChar.classList.add('final-flash');
                        // also add ripple effect to whole column border
                        if (reel.element) {
                            reel.element.style.transition = 'box-shadow 0.2s';
                            reel.element.style.boxShadow = '0 0 20px #39FF14, inset 0 0 8px #39FF14';
                            setTimeout(() => {
                                if (reel.element) reel.element.style.boxShadow = '';
                            }, 550);
                        }
                    }
                });
                // full viewport flash effect (outward burst)
                viewport.style.transition = 'box-shadow 0.3s ease-out, border-color 0.2s';
                viewport.style.boxShadow = '0 0 45px #39FF14, 0 0 80px #27AE60';
                viewport.style.borderColor = '#9AFF4A';
                setTimeout(() => {
                    viewport.style.boxShadow = '0 0 25px rgba(39, 174, 96, 0.5)';
                    viewport.style.borderColor = 'var(--ghost-neon-green)';
                }, 600);
            };
            
            // START SPIN with staggered delays and elegant easing
            // each reel spins downwards from top to final location
            const animations = [];
            
            reelsData.forEach((reel, idx) => {
                const distance = (reel.totalSymbols - 1) * charHeight;
                // different durations per reel: between 1500ms to 2600ms for natural slot feel
                const duration = 1700 + Math.random() * 1300; // 1.7s - 3.0s
                const delay = idx * 45;   // cascading delay per character (wave effect)
                
                const startTransform = () => {
                    reel.inner.style.transition = `transform ${duration}ms cubic-bezier(0.23, 0.96, 0.33, 1.05)`;
                    reel.inner.style.transform = `translateY(-${distance}px)`;
                };
                
                const timeoutId = setTimeout(startTransform, delay);
                animations.push(timeoutId);
                
                // after all animations finish, trigger final neon outburst
                const maxFinishTime = delay + duration + 200;
                if (idx === reelsData.length - 1) {
                    setTimeout(() => {
                        finalizeAndFlash();
                    }, maxFinishTime);
                } else {
                    // ensure final flash happens after last possible reel even if offset miscalc
                    if (idx === reelsData.length - 1) return;
                }
            });
            
            // Extra safety: overall forced flash after maximum duration (~3.5s)
            const longestPossible = (reelsData.length * 45) + 3000 + 200;
            setTimeout(() => {
                // check if flash already applied: if any char doesn't have flash class, apply clean outburst again
                let alreadyFlashed = false;
                for (let reel of reelsData) {
                    const lastSpan = reel.inner.children[reel.inner.children.length - 1];
                    if (lastSpan && lastSpan.classList.contains('final-flash')) {
                        alreadyFlashed = true;
                        break;
                    }
                }
                if (!alreadyFlashed) {
                    finalizeAndFlash();
                }
            }, longestPossible);
            
            // Also ensure that after spin we optionally apply micro fix for webkit
            window.addEventListener('load', () => {
                // if any column is not properly positioned because of dynamic font loading re-check height
                setTimeout(() => {
                    const freshHeight = document.querySelector('.slot-char')?.offsetHeight || charHeight;
                    if (Math.abs(freshHeight - charHeight) > 5) {
                        // re-adjust transforms slightly
                        reelsData.forEach(reel => {
                            const computedTransform = reel.inner.style.transform;
                            if (computedTransform && computedTransform !== 'none') {
                                const match = computedTransform.match(/translateY\(-([0-9.]+)px\)/);
                                if (match) {
                                    const oldDist = parseFloat(match[1]);
                                    const correctedDist = (reel.totalSymbols - 1) * freshHeight;
                                    if (Math.abs(oldDist - correctedDist) > 2) {
                                        reel.inner.style.transform = `translateY(-${correctedDist}px)`;
                                    }
                                }
                            }
                        });
                    }
                }, 100);
            });
            
            // Accessibility / guard: if any CSS transition not supported, still reveal final text but trigger flash.
            setTimeout(() => {
                // check reels that might have not transitioned due to error
                for (let reel of reelsData) {
                    if (!reel.inner.style.transform || reel.inner.style.transform === 'none') {
                        const dist = (reel.totalSymbols - 1) * charHeight;
                        reel.inner.style.transition = 'transform 800ms cubic-bezier(0.2,0.9,0.4,1.1)';
                        reel.inner.style.transform = `translateY(-${dist}px)`;
                    }
                }
            }, 100);
        })();
        
        // Modal & menu functionality (unchanged but ensure it works perfectly)
        const cookieModal = document.getElementById('cookieModal');
        const impressumModal = document.getElementById('impressumModal');
        const cookiePolicyLink = document.getElementById('cookiePolicyLink');
        const impressumLink = document.getElementById('impressumLink');
        const closeCookieBtn = document.getElementById('closeCookieModalBtn');
        const closeImpressumBtn = document.getElementById('closeImpressumModalBtn');
        const closeImpressumAcceptBtn = document.getElementById('closeImpressumAcceptBtn');
        
        function openCookieModal() { if(cookieModal) { cookieModal.style.display = 'flex'; document.body.style.overflow = 'hidden'; } }
        function closeCookieModal() { if(cookieModal) { cookieModal.style.display = 'none'; document.body.style.overflow = ''; } }
        function openImpressumModal() { if(impressumModal) { impressumModal.style.display = 'flex'; document.body.style.overflow = 'hidden'; } }
        function closeImpressumModal() { if(impressumModal) { impressumModal.style.display = 'none'; document.body.style.overflow = ''; } }
        
        if(cookiePolicyLink) cookiePolicyLink.addEventListener('click', (e) => { e.preventDefault(); openCookieModal(); });
        if(impressumLink) impressumLink.addEventListener('click', (e) => { e.preventDefault(); openImpressumModal(); });
        if(closeCookieBtn) closeCookieBtn.addEventListener('click', closeCookieModal);
        if(closeImpressumBtn) closeImpressumBtn.addEventListener('click', closeImpressumModal);
        if(closeImpressumAcceptBtn) closeImpressumAcceptBtn.addEventListener('click', closeImpressumModal);
        
        const acceptCookieBtn = document.getElementById('acceptCookieBtn');
        if(acceptCookieBtn) {
            acceptCookieBtn.addEventListener('click', () => {
                closeCookieModal();
                localStorage.setItem('cookiePolicyAccepted', 'true');
            });
        }
        
        window.addEventListener('click', (e) => {
            if(e.target === cookieModal) closeCookieModal();
            if(e.target === impressumModal) closeImpressumModal();
        });
        
        // Fix menu icon placeholder
        const menuImg = document.querySelector('.menu-icon');
        if(menuImg && menuImg.complete && menuImg.naturalWidth === 0) {
            menuImg.src = "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='%2327AE60'%3E%3Cpath d='M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z'/%3E%3C/svg%3E";
        }
    </script>
</body>
</html>
