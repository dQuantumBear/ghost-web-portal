    <script>
        const targetStr = "SECURE MESSENGER "; // Exactly 17 characters
        const charset = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%^&*()_+-=[]{}|;:,.<>?";
        const row = document.getElementById('main-row');
        const burst = document.getElementById('burst');
        const containers = [];

        // 1. Create 17 individual containers
        for (let i = 0; i < 17; i++) {
            const container = document.createElement('div');
            container.className = 'letter-container';

            const charSpan = document.createElement('span');
            charSpan.className = 'spinning-char';
            charSpan.textContent = charset[Math.floor(Math.random() * charset.length)];

            container.appendChild(charSpan);
            row.appendChild(container);

            containers.push({
                element: container,
                textNode: charSpan,
                target: targetStr[i],
                isRevealed: false,
                spinSpeed: 50 + Math.random() * 50 // ms per char change
            });
        }

        // 2. Spinning Logic for each container
        function spin(index) {
            const c = containers[index];
            if (c.isRevealed) return;

            // Change character randomly
            c.textNode.textContent = charset[Math.floor(Math.random() * charset.length)];

            // Visual downward spin effect (slight nudge)
            c.textNode.style.transform = `translateY(${Math.random() * 10}px)`;

            setTimeout(() => spin(index), c.spinSpeed);
        }

        // Start all spinning
        for (let i = 0; i < 17; i++) {
            spin(i);
        }

        // 3. Sequential Reveal Logic (7-10 seconds total)
        // We start revealing after 7 seconds, one by one.
        const startRevealTime = 7000;
        const revealInterval = 150; // 150ms between each letter reveal

        function revealNext(index) {
            if (index >= 17) {
                // All revealed, trigger outburst
                setTimeout(() => {
                    burst.classList.add('active');
                }, 200);
                return;
            }

            const c = containers[index];

            // Slow down simulation: just before revealing, we can "stutter" the spin
            // But for simplicity and impact, we lock it to the target
            c.isRevealed = true;
            c.textNode.textContent = c.target;
            c.element.classList.add('revealed');

            setTimeout(() => revealNext(index + 1), revealInterval);
        }

        // Trigger the reveal sequence after 7 seconds
        setTimeout(() => revealNext(0), startRevealTime);

        const cookieModal = document.getElementById('cookieModal');
        const impressumModal = document.getElementById('impressumModal');
        const cookiePolicyLink = document.getElementById('cookiePolicyLink');
        const impressumLink = document.getElementById('impressumLink');
        const closeCookieBtn = document.getElementById('closeCookieModalBtn');
        const closeImpressumBtn = document.getElementById('closeImpressumModalBtn');
        const closeImpressumAcceptBtn = document.getElementById('closeImpressumAcceptBtn');

        function openCookieModal() { cookieModal.style.display = 'flex'; document.body.style.overflow = 'hidden'; }
        function closeCookieModal() { cookieModal.style.display = 'none'; document.body.style.overflow = ''; }
        function openImpressumModal() { impressumModal.style.display = 'flex'; document.body.style.overflow = 'hidden'; }
        function closeImpressumModal() { impressumModal.style.display = 'none'; document.body.style.overflow = ''; }

        if (cookiePolicyLink) cookiePolicyLink.addEventListener('click', function(e) { e.preventDefault(); openCookieModal(); });
        if (impressumLink) impressumLink.addEventListener('click', function(e) { e.preventDefault(); openImpressumModal(); });
        if (closeCookieBtn) closeCookieBtn.addEventListener('click', closeCookieModal);
        if (closeImpressumBtn) closeImpressumBtn.addEventListener('click', closeImpressumModal);
        if (closeImpressumAcceptBtn) closeImpressumAcceptBtn.addEventListener('click', closeImpressumModal);

        const acceptCookieBtn = document.getElementById('acceptCookieBtn');
        if (acceptCookieBtn) {
            acceptCookieBtn.addEventListener('click', function() {
                closeCookieModal();
                localStorage.setItem('cookiePolicyAccepted', 'true');
            });
        }

        window.addEventListener('click', function(e) {
            if (e.target === cookieModal) closeCookieModal();
            if (e.target === impressumModal) closeImpressumModal();
        });

        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                if (cookieModal.style.display === 'flex') closeCookieModal();
                if (impressumModal.style.display === 'flex') closeImpressumModal();
            }
        });
    </script>
</body>
</html>
