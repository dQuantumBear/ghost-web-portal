    <footer>
        <img src="/app_icon_bear.jpg" alt="Sovereign Bear" class="bottom-bear"><br>
        <span class="footer-signature">🐻❤️M</span><br><br>
        &copy; 2026 Secure Messenger Project. Engineered for Privacy.
    </footer>

    <script>
        /**
         * CHAOS SLOT ENGINE (v17.3.0 - RECOVERY)
         * Web Implementation of the Android CipherReelTextView logic.
         */
        class CipherReelEngine {
            constructor(containerId, targetText) {
                this.container = document.getElementById(containerId);
                this.targetText = targetText.toUpperCase();
                this.symbols = "!@#$%^&*()_+=-{}[]|:;\"'<>,.?/".split('');
                this.letters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ".split('');
                this.numbers = "0123456789".split('');
                this.masterPool = [...this.symbols, ...this.letters, ...this.numbers];
                this.baseDuration = 12000; // Match Android baseDuration
                this.columns = [];
                this.maxTotalTime = 0;
                this.charHeight = 1.8; // Match CSS and Android 1.8f scaling
            }

            init() {
                this.container.innerHTML = '';
                const mainWrapper = document.createElement('div');
                mainWrapper.className = 'slot-machine-container';

                const viewport = document.createElement('div');
                viewport.className = 'reel-viewport';
                mainWrapper.appendChild(viewport);

                const hasAnimated = sessionStorage.getItem('hasAnimatedTitle') === 'true';

                for (let i = 0; i < this.targetText.length; i++) {
                    const char = this.targetText[i];

                    if (char === ' ') {
                        const spacer = document.createElement('div');
                        spacer.style.width = '0.4em';
                        viewport.appendChild(spacer);
                        continue;
                    }

                    const column = document.createElement('div');
                    column.className = 'slot-column';

                    const reel = this.generateChaosReel(char);
                    reel.forEach(c => {
                        const div = document.createElement('div');
                        div.className = 'slot-char';
                        div.textContent = c;
                        column.appendChild(div);
                    });

                    // Measurement Lock: Ensure we use the exact rendered height
                    if (i === 0) {
                        const testChar = column.firstChild;
                        // Use a small timeout if needed, but clientHeight works after append
                        viewport.appendChild(column);
                        this.measuredCharHeight = testChar.offsetHeight;
                    } else {
                        viewport.appendChild(column);
                    }

                    // Match Android Randomness
                    const duration = this.baseDuration - 2000 + Math.random() * 6000;
                    const delay = Math.random() * 2000;
                    this.maxTotalTime = Math.max(this.maxTotalTime, duration + delay);

                    if (hasAnimated) {
                        const finalPos = (reel.length - 1) * this.measuredCharHeight;
                        column.style.transform = `translate3d(0, -${finalPos}px, 0)`;
                    }

                    this.columns.push({
                        element: column,
                        reelSize: reel.length,
                        duration: duration,
                        delay: delay
                    });
                }

                const burst = document.createElement('div');
                burst.className = 'burst-layer';
                burst.id = 'neon-burst';
                burst.textContent = this.targetText;
                mainWrapper.appendChild(burst);

                this.container.appendChild(mainWrapper);

                if (!hasAnimated) {
                    setTimeout(() => this.start(), 300);
                    sessionStorage.setItem('hasAnimatedTitle', 'true');
                }
            }

            generateChaosReel(targetChar) {
                // Match Android reel length: Random.nextInt(100, 151)
                const length = Math.floor(Math.random() * 51) + 100;
                const reel = [];
                for (let i = 0; i < length - 1; i++) {
                    reel.push(this.masterPool[Math.floor(Math.random() * this.masterPool.length)]);
                }
                reel.push(targetChar);
                return reel;
            }

            start() {
                this.columns.forEach(col => {
                    requestAnimationFrame(() => {
                        requestAnimationFrame(() => {
                            // Match Android's DecelerateInterpolator(randomFactor)
                            // factor between 2.0 and 3.0 maps roughly to cubic-bezier(0, 0, 0.1-0.2, 1)
                            const factor = 0.1 + (Math.random() * 0.1);
                            col.element.style.transition = `transform ${col.duration}ms cubic-bezier(0, 0, ${factor.toFixed(2)}, 1) ${col.delay}ms`;
                            const travelDistance = (col.reelSize - 1) * this.measuredCharHeight;
                            col.element.style.transform = `translate3d(0, -${travelDistance}px, 0)`;
                        });
                    });
                });

                // Final Burst overlay
                setTimeout(() => {
                    const burst = document.getElementById('neon-burst');
                    if (burst) {
                        burst.style.animation = 'neonBurst 1.2s ease-out forwards';
                    }
                }, this.maxTotalTime + 200);
            }
        }

        document.addEventListener('DOMContentLoaded', function() {
            const engine = new CipherReelEngine('title-container', "SECURE MESSENGER");
            engine.init();
        });

        const cookieModal = document.getElementById('cookieModal');
        const impressumModal = document.getElementById('impressumModal');
        const cookiePolicyLink = document.getElementById('cookiePolicyLink');
        const impressumLink = document.getElementById('impressumLink');
        const closeCookieBtn = document.getElementById('closeCookieModalBtn');
        const closeImpressumBtn = document.getElementById('closeImpressumModalBtn');
        const closeImpressumAcceptBtn = document.getElementById('closeImpressumAcceptBtn');

        function openCookieModal() { cookieModal.style.display = 'flex'; document.body.style.overflow = 'hidden'; }
        function closeCookieModal() { cookieModal.style.display = 'none'; document.body.style.overflow = ''; }
        function openImpressumModal() { impressumModal.style.display = 'flex'; document.body.style.overflow = 'hidden'; }
        function closeImpressumModal() { impressumModal.style.display = 'none'; document.body.style.overflow = ''; }

        if (cookiePolicyLink) cookiePolicyLink.addEventListener('click', function(e) { e.preventDefault(); openCookieModal(); });
        if (impressumLink) impressumLink.addEventListener('click', function(e) { e.preventDefault(); openImpressumModal(); });
        if (closeCookieBtn) closeCookieBtn.addEventListener('click', closeCookieModal);
        if (closeImpressumBtn) closeImpressumBtn.addEventListener('click', closeImpressumModal);
        if (closeImpressumAcceptBtn) closeImpressumAcceptBtn.addEventListener('click', closeImpressumModal);

        const acceptCookieBtn = document.getElementById('acceptCookieBtn');
        if (acceptCookieBtn) {
            acceptCookieBtn.addEventListener('click', function() {
                closeCookieModal();
                localStorage.setItem('cookiePolicyAccepted', 'true');
            });
        }

        window.addEventListener('click', function(e) {
            if (e.target === cookieModal) closeCookieModal();
            if (e.target === impressumModal) closeImpressumModal();
        });

        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                if (cookieModal.style.display === 'flex') closeCookieModal();
                if (impressumModal.style.display === 'flex') closeImpressumModal();
            }
        });
    </script>
</body>
</html>
