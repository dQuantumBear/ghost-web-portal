            max-width: 180px;
            height: auto;
            margin: 0 auto 30px auto;
            border-radius: 12px;
            box-shadow: 0 0 15px rgba(39, 174, 96, 0.4);
        }

        @media (max-width: 480px) {
            .ghost-line { font-size: 1.05em; }
            h1 { font-size: 1.6em; }
            .download-soon-img { max-width: 60%; }
            .dropdown-content { right: -10px; min-width: 200px; }
            .modal-content { width: 95%; }
        }

        .support-box {
            text-align: center;
            border: 1px solid var(--ghost-neon-green);
        }

        .bear-img {
            max-width: 150px;
            border-radius: 50%;
            border: 2px solid var(--ghost-neon-green);
            margin-bottom: 20px;
        }

        .bottom-bear {
            max-width: 60px;
            margin-top: 20px;
        }

        .highlight { color: var(--ghost-neon-green); font-weight: bold; }

        .footer-signature {
            font-size: 1.5em;
            margin-top: 20px;
            display: block;
        }

        footer {
            text-align: center;
            padding: 40px 20px;
            font-size: 0.8em;
            color: #777;
            background: #050505;
        }
    </style>
