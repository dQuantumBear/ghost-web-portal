<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>Secure Messenger | Sovereign Ghost Protocol</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --bg-black: #000000;
            --ghost-dark-green: #004D00;
            --ghost-neon-green: #27AE60;
            --ghost-white: #FFFFFF;
            --ghost-cream: #FFFDD0;
            --outburst-core: #39FF14;
        }

        body {
            background-color: var(--bg-black);
            color: var(--ghost-white);
            font-family: 'Courier New', Courier, monospace;
            margin: 0;
            padding: 0;
            line-height: 1.4;
            overflow-x: hidden;
        }

        /* --- MODAL STYLES --- */
        .modal-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.85);
            backdrop-filter: blur(8px);
            z-index: 2000;
            justify-content: center;
            align-items: center;
        }
        .modal-content {
            background-color: var(--bg-black);
            border: 2px solid var(--ghost-neon-green);
            border-radius: 16px;
            max-width: 500px;
            width: 90%;
            animation: modalFadeIn 0.3s ease-out;
        }
        @keyframes modalFadeIn {
            from { opacity: 0; transform: scale(0.95); }
            to { opacity: 1; transform: scale(1); }
        }
        .modal-header { padding: 20px 25px 10px; border-bottom: 1px solid var(--ghost-dark-green); display: flex; justify-content: space-between; }
        .modal-header h2 { color: var(--ghost-neon-green); margin: 0; }
        .close-modal { background: none; border: none; color: var(--ghost-neon-green); font-size: 28px; cursor: pointer; }
        .modal-body { padding: 20px 25px; color: var(--ghost-cream); }
        .accept-btn { width: 100%; padding: 12px; background: transparent; border: 2px solid var(--ghost-neon-green); color: var(--ghost-neon-green); cursor: pointer; font-family: inherit; transition: 0.3s; }
        .accept-btn:hover { background: var(--ghost-dark-green); box-shadow: 0 0 15px var(--ghost-neon-green); }
        
        /* Menu */
        .menu-container { position: absolute; top: 20px; right: 20px; z-index: 1000; }
        .menu-icon { width: 50px; cursor: pointer; filter: drop-shadow(0 0 5px var(--ghost-neon-green)); }
        .dropdown-content { display: none; position: absolute; right: 0; top: 100%; background: var(--bg-black); min-width: 240px; border: 2px solid var(--ghost-neon-green); border-radius: 8px; z-index: 1001; }
        .menu-container:hover .dropdown-content { display: block; }
        .dropdown-content a { display: block; padding: 12px 20px; color: var(--ghost-white); text-decoration: none; cursor: pointer; }
        .dropdown-content a:hover { background: var(--ghost-dark-green); color: var(--ghost-neon-green); }

        header {
            padding: 40px 20px 60px;
            text-align: center;
            background: linear-gradient(to bottom, var(--ghost-dark-green), var(--bg-black));
            border-bottom: 1px solid var(--ghost-neon-green);
        }
        .logo {
            max-width: 120px;
            margin-bottom: 25px;
            animation: redToGreenGlow 3s infinite;
        }
        @keyframes redToGreenGlow {
            0% { filter: drop-shadow(0 0 5px #FF0000); }
            50% { filter: drop-shadow(0 0 20px #27AE60); }
            100% { filter: drop-shadow(0 0 5px #FF0000); }
        }

        /* ========== SLOT MACHINE - ONE ROW OF CONTAINERS ========== */
        .slot-machine-wrapper {
            display: flex;
            justify-content: center;
            margin: 30px auto;
            padding: 0 15px;
        }
        .reel-strip {
            display: flex;
            flex-direction: row;
            flex-wrap: nowrap;
            justify-content: center;
            align-items: center;
            gap: 6px;
            background: #0a0f0a;
            border: 3px solid var(--ghost-neon-green);
            border-radius: 20px;
            padding: 18px 24px;
            box-shadow: 0 0 20px rgba(39, 174, 96, 0.4);
            overflow-x: auto;
        }
        .reel {
            width: 70px;
            height: 95px;
            background: #010301;
            border-radius: 12px;
            overflow: hidden;
            position: relative;
            box-shadow: inset 0 0 10px rgba(0,0,0,0.8), 0 0 5px rgba(57,255,20,0.3);
        }
        .reel-inner {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            will-change: transform;
        }
        .reel-char {
            display: flex;
            align-items: center;
            justify-content: center;
            height: 95px;
            font-size: 52px;
            font-weight: bold;
            font-family: 'Courier New', monospace;
            color: var(--ghost-neon-green);
            text-shadow: 0 0 8px var(--ghost-neon-green);
            background: #000000aa;
        }
        .spacer-block {
            width: 28px;
            display: inline-block;
        }

        /* NEON GREEN OUTBURST */
        @keyframes neonOutburst {
            0% { text-shadow: 0 0 2px #39FF14; color: #27AE60; }
            15% { text-shadow: 0 0 25px #39FF14, 0 0 50px #fff; color: #FFFFFF; }
            35% { text-shadow: 0 0 15px #39FF14, 0 0 30px #39FF14; color: #aaff99; }
            65% { text-shadow: 0 0 30px #39FF14, 0 0 70px #39FF14; color: #e0ffe0; }
            100% { text-shadow: 0 0 12px var(--ghost-neon-green); color: var(--ghost-neon-green); }
        }
        .outburst-glow {
            animation: neonOutburst 0.6s cubic-bezier(0.3, 1.2, 0.4, 1) forwards !important;
        }
        .reel-flash {
            transition: box-shadow 0.1s ease;
            box-shadow: 0 0 0 2px var(--ghost-neon-green), inset 0 0 20px #39FF14 !important;
        }

        .tagline {
            color: var(--ghost-neon-green);
            font-size: 0.9rem;
            margin-top: 20px;
            letter-spacing: 1px;
        }
        .ghost-btn {
            display: inline-block;
            padding: 12px 28px;
            margin-top: 20px;
            border: 2px solid var(--ghost-neon-green);
            color: var(--ghost-neon-green);
            text-decoration: none;
            font-weight: bold;
            transition: 0.3s;
            background: transparent;
            cursor: pointer;
        }
        .ghost-btn:hover {
            background: var(--ghost-dark-green);
            box-shadow: 0 0 20px var(--ghost-neon-green);
        }
        .container { max-width: 800px; margin: 0 auto; padding: 20px; }
        section {
            background: rgba(0, 77, 0, 0.1);
            margin-bottom: 30px;
            padding: 25px;
            border-radius: 20px;
            border: 1px solid rgba(39, 174, 96, 0.3);
            opacity: 0;
            animation: fadeSlideUp 0.5s forwards;
            animation-delay: calc(2.5s + (var(--order,0) * 0.1s));
        }
        @keyframes fadeSlideUp { to { opacity: 1; transform: translateY(0); } from { opacity: 0; transform: translateY(20px); } }
        section:nth-child(1) { --order: 1; }
        section:nth-child(2) { --order: 2; }
        section:nth-child(3) { --order: 3; }
        section:nth-child(4) { --order: 4; }
        section:nth-child(5) { --order: 5; }
        h2 { color: var(--ghost-neon-green); border-bottom: 1px solid var(--ghost-dark-green); padding-bottom: 10px; margin-bottom: 15px; }
        .ghost-line { font-size: 1.4rem; text-align: center; margin: 30px 0; opacity: 0; animation: fadeInText 0.6s 2.2s forwards; }
        @keyframes fadeInText { to { opacity: 1; } }
        .highlight { color: var(--ghost-neon-green); font-weight: bold; }
        .download-soon-img { display: block; margin: 40px auto; max-width: 280px; filter: drop-shadow(0 0 10px rgba(39,174,96,0.4)); }
        footer { text-align: center; padding: 40px; color: #777; background: #050505; }

        @media (max-width: 750px) {
            .reel { width: 42px; height: 60px; }
            .reel-char { height: 60px; font-size: 32px; }
            .spacer-block { width: 12px; }
            .reel-strip { gap: 3px; padding: 12px 15px; }
            .ghost-line { font-size: 1rem; white-space: normal; }
        }
    </style>
</head>
<body>

<!-- MENU (unaltered) -->
<div class="menu-container">
