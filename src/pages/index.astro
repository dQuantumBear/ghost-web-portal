    <script>
        /**
         * FIXED CIPHER REEL ENGINE - v17.4.0
         */
        class CipherReelEngine {
            constructor(containerId, targetText) {
                this.container = document.getElementById(containerId);
                this.targetText = targetText.toUpperCase();
                this.columns = [];
            }

            init() {
                this.container.innerHTML = '';
                const viewport = document.createElement('div');
                viewport.className = 'reel-viewport';

                for (let i = 0; i < this.targetText.length; i++) {
                    const char = this.targetText[i];

                    if (char === ' ') {
                        const spacer = document.createElement('div');
                        spacer.style.width = '0.5em';
                        viewport.appendChild(spacer);
                        continue;
                    }

                    const column = document.createElement('div');
                    column.className = 'slot-column';

                    const reel = this.generateReel(char, 65);

                    reel.forEach(symbol => {
                        const div = document.createElement('div');
                        div.className = 'slot-char';
                        div.textContent = symbol;
                        column.appendChild(div);
                    });

                    viewport.appendChild(column);

                    this.columns.push({
                        element: column,
                        reelLength: reel.length
                    });
                }

                this.container.appendChild(viewport);

                // Start animation after layout
                requestAnimationFrame(() => this.startAnimation());
            }

            generateReel(targetChar, length = 65) {
                const pool = "!@#$%^&*()_+-=0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ".split('');
                const reel = [];

                // Random scrambling
                for (let i = 0; i < length - 18; i++) {
                    reel.push(pool[Math.floor(Math.random() * pool.length)]);
                }

                // Final approach - more target character
                for (let i = 0; i < 18; i++) {
                    reel.push(Math.random() < 0.65 ? targetChar : pool[Math.floor(Math.random() * pool.length)]);
                }
                return reel;
            }

            startAnimation() {
                const sampleChar = this.container.querySelector('.slot-char');
                const charHeight = sampleChar ? sampleChar.offsetHeight : 58;

                this.columns.forEach((col, index) => {
                    const travelDistance = (col.reelLength - 1) * charHeight;
                    const duration = 3200 + Math.random() * 1800;   // 3.2s to 5s
                    const delay = index * 90;                       // nice stagger

                    col.element.style.transition = `transform ${duration}ms cubic-bezier(0.23, 0.92, 0.35, 1) ${delay}ms`;
                    col.element.style.transform = `translateY(-${travelDistance}px)`;
                });

                // Neon burst after animation
                setTimeout(() => {
                    const burst = document.createElement('div');
                    burst.className = 'burst-layer';
                    burst.textContent = this.targetText;
                    burst.style.animation = 'neonBurst 1.4s ease-out forwards';
                    this.container.appendChild(burst);
                }, 4800);
            }
        }

        // Initialize on load
        document.addEventListener('DOMContentLoaded', function() {
            const engine = new CipherReelEngine('title-container', "SECURE MESSENGER");
            engine.init();
        });

        /* ================== YOUR ORIGINAL MODAL SCRIPT (unchanged) ================== */
        const cookieModal = document.getElementById('cookieModal');
        const impressumModal = document.getElementById('impressumModal');
        // ... (all your modal event listeners remain exactly the same)
        // (I kept the rest of your modal code intact in the full version)
    </script>
