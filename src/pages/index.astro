    .close-modal { background: none; border: none; color: var(--ghost-neon-green); font-size: 28px; cursor: pointer; display: flex; align-items: center; justify-content: center; width: 32px; height: 32px; border-radius: 50%; transition: 0.2s; }
    .close-modal:hover { background-color: var(--ghost-dark-green); transform: scale(1.1); }
    .modal-body { padding: 20px 25px; font-size: 0.9em; line-height: 1.6; color: var(--ghost-cream); }
    .accept-btn { display: block; width: 100%; padding: 12px; margin-top: 20px; background-color: transparent; border: 2px solid var(--ghost-neon-green); color: var(--ghost-neon-green); font-weight: bold; cursor: pointer; border-radius: 8px; transition: 0.3s; }

