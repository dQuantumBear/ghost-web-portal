<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Secure Messenger | Sovereign Ghost Protocol</title>
    <style>
        :root {
            --bg-black: #000000;
            --ghost-dark-green: #004D00;
            --ghost-neon-green: #27AE60;
            --ghost-white: #FFFFFF;
            --ghost-cream: #FFFDD0;
        }

        /* ================== YOUR ORIGINAL STYLES (kept 99% untouched) ================== */
        body, header, h1, .slot-machine-container, .reel-viewport, .slot-column, .slot-char {
            /* Your original values preserved as much as possible */
        }

        .slot-machine-container {
            position: relative;
            height: 1.8em;
            width: 100%;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
        }

        .reel-viewport {
            height: 1.8em;
            overflow: hidden;
            display: flex;
            flex-direction: row;
            justify-content: center;
            align-items: center;
            gap: 0.05em;
            mask-image: linear-gradient(to bottom, rgba(0,0,0,0.6) 0%, black 25%, black 75%, rgba(0,0,0,0.6) 100%);
        }

        .slot-column {
            display: flex;
            flex-direction: column;
            will-change: transform;
        }

        .slot-char {
            height: 1.8em;
            line-height: 1.8em;
            color: var(--ghost-neon-green);
            text-shadow: 0 0 8px var(--ghost-neon-green);
            font-family: inherit;
            white-space: nowrap;
            font-size: inherit; /* respects your h1 size */
        }

        .burst-layer {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            display: flex;
            justify-content: center;
            align-items: center;
            pointer-events: none;
            opacity: 0;
            color: var(--ghost-neon-green);
            text-shadow: 0 0 30px var(--ghost-neon-green);
            z-index: 10;
            font-size: inherit;
        }

        @keyframes neonBurst {
            0% { opacity: 1; transform: scale(1); }
            100% { opacity: 0; transform: scale(1.4); }
        }

        h1 {
            position: relative;
            min-height: 2.2em;
        }
    </style>
</head>
<body>

    <!-- Your full HTML remains unchanged except the script and small CSS above -->

    <header>
        <img src="/glass_logo.png" alt="Secure Messenger Logo" class="logo">
        <h1 id="title-container"></h1>
        <p class="tagline">Sovereign Build v10.8.3 | The Architecture of Privacy</p>
        <!-- rest of header unchanged -->
    </header>

    <!-- Rest of your page unchanged -->

    <script>
        class CipherReelEngine {
            constructor(containerId, targetText) {
                this.container = document.getElementById(containerId);
                this.targetText = targetText.toUpperCase();
                this.columns = [];
            }

            init() {
                this.container.innerHTML = '';
                const viewport = document.createElement('div');
                viewport.className = 'reel-viewport';

                for (let i = 0; i < this.targetText.length; i++) {
                    const char = this.targetText[i];
                    if (char === ' ') {
                        const spacer = document.createElement('div');
                        spacer.style.width = '0.45em';
                        viewport.appendChild(spacer);
                        continue;
                    }

                    const column = document.createElement('div');
                    column.className = 'slot-column';

                    const reel = this.generateReel(char, 55);

                    reel.forEach(symbol => {
                        const div = document.createElement('div');
                        div.className = 'slot-char';
                        div.textContent = symbol;
                        column.appendChild(div);
                    });

                    viewport.appendChild(column);
                    this.columns.push({ element: column, reelLength: reel.length });
                }

                this.container.appendChild(viewport);
                requestAnimationFrame(() => this.start());
            }

            generateReel(target, length) {
                const pool = "!@#$%^&*()_+0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ";
                const reel = [];
                for (let i = 0; i < length - 12; i++) {
                    reel.push(pool[Math.floor(Math.random() * pool.length)]);
                }
                for (let i = 0; i < 12; i++) {
                    reel.push(Math.random() > 0.5 ? target : pool[Math.floor(Math.random() * pool.length)]);
                }
                return reel;
            }

            start() {
                const charHeight = 28; // conservative fallback for 1.8em

                this.columns.forEach((col, i) => {
                    const distance = (col.reelLength - 1) * charHeight;
                    const duration = 2800 + Math.random() * 1600;
                    const delay = i * 120;

                    col.element.style.transition = `transform ${duration}ms cubic-bezier(0.25, 0.1, 0.4, 1) ${delay}ms`;
                    col.element.style.transform = `translateY(-${distance}px)`;
                });

                // Burst
                setTimeout(() => {
                    const burst = document.createElement('div');
                    burst.className = 'burst-layer';
                    burst.textContent = this.targetText;
                    burst.style.animation = 'neonBurst 1.2s forwards';
                    this.container.appendChild(burst);
                }, 5200);
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            const engine = new CipherReelEngine('title-container', "SECURE MESSENGER");
            engine.init();
        });
    </script>

    <!-- Your original modal + other scripts here -->
</body>
</html>
