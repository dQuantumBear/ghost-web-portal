            box-shadow: 0 0 20px rgba(39, 174, 96, 0.3);
            opacity: 0;
            animation: fadeInUp 0.5s ease-out forwards;
            animation-delay: calc(2.5s + (var(--order, 0) * 0.1s));
        }

        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        section:nth-child(1) { --order: 1; }
        section:nth-child(2) { --order: 2; }
        section:nth-child(3) { --order: 3; }
        section:nth-child(4) { --order: 4; }
        section:nth-child(5) { --order: 5; }
        section:nth-child(6) { --order: 6; }
        section:nth-child(7) { --order: 7; }

        section:hover {
            box-shadow: 0 0 30px rgba(39, 174, 96, 0.5);
            border-color: rgba(39, 174, 96, 0.6);
        }

        h2 {
            color: var(--ghost-neon-green);
            text-transform: uppercase;
            font-size: 1.2em;
            border-bottom: 1px solid var(--ghost-dark-green);
            padding-bottom: 10px;
            margin-top: 0;
        }

        .ghost-line {
            font-size: 1.5em;
            color: var(--ghost-cream);
            text-align: center;
            font-weight: bold;
            white-space: nowrap;
            margin: 25px 0;
            display: block;
            opacity: 0;
            animation: fadeIn 0.5s ease-in 2.3s forwards;
        }

        /* AI-FIX: Proportional Download Button (v10.8.3) */
        .download-soon-img {
            display: block;
            margin: 50px auto;
            max-width: 320px; /* Perfectly sized for 800px container (approx 40%) */
            width: 90%;
            height: auto;
            filter: drop-shadow(0 0 15px rgba(39, 174, 96, 0.4));
            transition: transform 0.3s ease, filter 0.3s ease;
        }

        .download-soon-img:hover {
            transform: scale(1.05);
            filter: drop-shadow(0 0 25px rgba(39, 174, 96, 0.6));
        }

        @media (max-width: 480px) {
            .ghost-line { font-size: 1.05em; white-space: normal; }
            h1 { font-size: 1.6em; flex-direction: column; }
            .download-soon-img { max-width: 80%; margin: 30px auto; }
            .dropdown-content { right: -10px; min-width: 200px; }
            .modal-content { width: 95%; }
            .logo { max-width: 80px; }
        }

        .support-box {
            text-align: center;
            border: 1px solid var(--ghost-neon-green);
        }

        .bear-img {
            max-width: 150px;
            border-radius: 50%;
            border: 2px solid var(--ghost-neon-green);
            margin-bottom: 20px;
            transition: all 0.3s ease;
            box-shadow: 0 0 15px rgba(39, 174, 96, 0.3);
        }

        .bear-img:hover {
            box-shadow: 0 0 25px rgba(39, 174, 96, 0.6);
        }

        .bottom-bear {
            max-width: 60px;
            margin-top: 20px;
            transition: all 0.3s ease;
        }

        .bottom-bear:hover {
            filter: drop-shadow(0 0 8px var(--ghost-neon-green));
        }

        .highlight { color: var(--ghost-neon-green); font-weight: bold; }

        .footer-signature {
            font-size: 1.5em;
            margin-top: 20px;
            display: block;
        }

        footer {
            text-align: center;
            padding: 40px 20px;
            font-size: 0.8em;
            color: #777;
            background: #050505;
        }

        .signature-creator {
            opacity: 0;
            animation: fadeIn 0.5s ease-in 2.8s forwards;
        }
    </style>
