<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Secure Messenger | Sovereign Ghost Protocol</title>
    <style>
        :root {
            --bg-black: #000000;
            --ghost-dark-green: #004D00;
            --ghost-neon-green: #27AE60;
            --ghost-white: #FFFFFF;
            --ghost-cream: #FFFDD0;
            --ghost-red: #FF0000;
            --ghost-dark-red: #8B0000;
        }

        html { scroll-behavior: smooth; }

        body {
            background-color: var(--bg-black);
            color: var(--ghost-white);
            font-family: 'Courier New', Courier, monospace;
            margin: 0;
            padding: 0;
            line-height: 1.4;
            position: relative;
            overflow-x: hidden;
        }

        /* Modal Overlay - Floating Window */
        .modal-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.85);
            backdrop-filter: blur(8px);
            z-index: 2000;
            justify-content: center;
            align-items: center;
        }

        .modal-content {
            position: relative;
            background-color: var(--bg-black);
            border: 2px solid var(--ghost-neon-green);
            border-radius: 16px;
            max-width: 500px;
            width: 90%;
            max-height: 80vh;
            overflow-y: auto;
            box-shadow: 0 0 40px rgba(39, 174, 96, 0.5);
            animation: modalFadeIn 0.3s ease-out;
        }

        @keyframes modalFadeIn {
            from {
                opacity: 0;
                transform: scale(0.95);
            }
            to {
                opacity: 1;
                transform: scale(1);
            }
        }

        .modal-header {
            padding: 20px 25px 10px 25px;
            border-bottom: 1px solid var(--ghost-dark-green);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .modal-header h2 {
            margin: 0;
            color: var(--ghost-neon-green);
            text-transform: uppercase;
            font-size: 1.3em;
            border: none;
            padding: 0;
        }

        .close-modal {
            background: none;
            border: none;
            color: var(--ghost-neon-green);
            font-size: 28px;
            cursor: pointer;
            padding: 0;
            width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            transition: 0.2s;
        }

        .close-modal:hover {
            background-color: var(--ghost-dark-green);
            transform: scale(1.1);
        }

        .modal-body {
            padding: 20px 25px;
            font-size: 0.9em;
            line-height: 1.6;
            color: var(--ghost-cream);
        }

        .modal-body p {
            margin: 10px 0;
        }

        .modal-body code {
            background: rgba(39, 174, 96, 0.2);
            padding: 2px 6px;
            border-radius: 4px;
            font-family: monospace;
            color: var(--ghost-neon-green);
        }

        .accept-btn {
            display: block;
            width: 100%;
            padding: 12px;
            margin-top: 20px;
            background-color: transparent;
            border: 2px solid var(--ghost-neon-green);
            color: var(--ghost-neon-green);
            font-weight: bold;
            font-size: 1em;
            cursor: pointer;
            border-radius: 8px;
            transition: 0.3s;
            font-family: inherit;
        }

        .accept-btn:hover {
            background-color: var(--ghost-dark-green);
            color: var(--ghost-white);
            box-shadow: 0 0 15px var(--ghost-neon-green);
        }

        .menu-container {
            position: absolute;
            top: 20px;
            right: 20px;
            z-index: 1000;
        }

        .menu-icon {
            width: 50px;
            height: auto;
            cursor: pointer;
            filter: drop-shadow(0 0 5px var(--ghost-neon-green));
            transition: 0.3s;
        }

        .menu-icon:hover { transform: scale(1.1); }

        .dropdown-content {
            display: none;
            position: absolute;
            right: 0;
            top: 100%;
            background-color: var(--bg-black);
            min-width: 240px;
            border: 2px solid var(--ghost-neon-green);
            border-radius: 8px;
            box-shadow: 0 0 20px rgba(39, 174, 96, 0.4);
            padding: 10px 0;
            z-index: 101;
        }

        .menu-container:hover .dropdown-content { display: block; }

        .dropdown-content a {
            color: var(--ghost-white);
            padding: 12px 20px;
            text-decoration: none;
            display: block;
            font-size: 0.9em;
            text-transform: uppercase;
            font-weight: bold;
            transition: 0.2s;
            border-bottom: 1px solid rgba(39, 174, 96, 0.1);
            cursor: pointer;
        }

        .dropdown-content a:last-child { border-bottom: none; }

        .dropdown-content a:hover {
            background-color: var(--ghost-dark-green);
            color: var(--ghost-neon-green);
        }

        header {
            padding: 60px 10px;
            text-align: center;
            background: linear-gradient(to bottom, var(--ghost-dark-green), var(--bg-black));
            border-bottom: 1px solid var(--ghost-neon-green);
        }

        .logo {
            max-width: 120px;
            height: auto;
            margin-bottom: 15px;
            animation: redToGreenGlow 3s ease-in-out infinite;
            transition: transform 0.3s ease;
        }

        .logo:hover {
            transform: scale(1.05);
            animation: redToGreenGlowFast 1.5s ease-in-out infinite;
        }

        @keyframes redToGreenGlow {
            0% {
                filter: drop-shadow(0 0 5px #FF0000) drop-shadow(0 0 10px #FF0000);
                opacity: 1;
            }
            25% {
                filter: drop-shadow(0 0 15px #FF4500) drop-shadow(0 0 25px #FF4500);
                opacity: 0.95;
            }
            50% {
                filter: drop-shadow(0 0 20px #27AE60) drop-shadow(0 0 35px #27AE60);
                opacity: 1;
            }
            75% {
                filter: drop-shadow(0 0 15px #00FF00) drop-shadow(0 0 25px #00FF00);
                opacity: 0.95;
            }
            100% {
                filter: drop-shadow(0 0 5px #FF0000) drop-shadow(0 0 10px #FF0000);
                opacity: 1;
            }
        }

        @keyframes redToGreenGlowFast {
            0% {
                filter: drop-shadow(0 0 8px #FF0000) drop-shadow(0 0 15px #FF0000);
            }
            25% {
                filter: drop-shadow(0 0 20px #FF4500) drop-shadow(0 0 35px #FF4500);
            }
            50% {
                filter: drop-shadow(0 0 25px #27AE60) drop-shadow(0 0 45px #27AE60);
            }
            75% {
                filter: drop-shadow(0 0 20px #00FF00) drop-shadow(0 0 35px #00FF00);
            }
            100% {
                filter: drop-shadow(0 0 8px #FF0000) drop-shadow(0 0 15px #FF0000);
            }
        }

        /* --- STABLE MATRIX CIPHER REEL SYSTEM --- */
        .slot-machine-container {
            display: flex;
            justify-content: center;
            align-items: center;
            width: 100%;
            margin: 20px 0;
            overflow: hidden;
        }

        .reel-viewport {
            display: inline-flex;
            flex-direction: row;
            justify-content: center;
            align-items: center;
            gap: 6px;
            height: 70px;
            overflow: hidden;
            border: 2px solid var(--ghost-neon-green);
            border-radius: 8px;
            background: rgba(0, 0, 0, 0.95);
            padding: 0 20px;
            box-shadow: 0 0 25px rgba(39, 174, 96, 0.4);
        }

        .slot-column {
            display: inline-flex;
            flex-direction: column;
            width: 28px;
            position: relative;
            will-change: transform;
            transform: translateY(0);
        }

        .slot-char {
            height: 70px;
            line-height: 70px;
            font-size: 36px;
            font-weight: bold;
            color: var(--ghost-neon-green);
            text-shadow: 0 0 12px var(--ghost-neon-green);
            text-align: center;
            font-family: 'Courier New', Courier, monospace;
        }

        h1 {
            margin: 0;
            padding: 0;
            min-height: 110px;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .tagline {
            color: var(--ghost-neon-green);
            font-weight: bold;
            font-size: 1em;
            margin-top: 5px;
            opacity: 0;
            animation: fadeIn 0.5s ease-in 2.5s forwards;
        }

        @keyframes fadeIn {
            to { opacity: 1; }
        }

        .ghost-btn {
            display: inline-block;
            padding: 12px 24px;
            margin-top: 25px;
            border: 2px solid var(--ghost-neon-green);
            color: var(--ghost-neon-green);
            text-decoration: none;
            font-weight: bold;
            letter-spacing: 2px;
            transition: 0.3s;
            border-radius: 4px;
            font-size: 0.9em;
            opacity: 0;
            animation: fadeIn 0.5s ease-in 2.8s forwards;
        }

        .ghost-btn:hover {
            background-color: var(--ghost-dark-green);
            color: var(--ghost-white);
            box-shadow: 0 0 15px var(--ghost-neon-green);
        }

        .container {
            max-width: 800px;
            margin: 0 auto;
            padding: 20px;
        }

        section {
            background-color: rgba(0, 77, 0, 0.1);
            margin-bottom: 30px;
            padding: 25px;
            border-radius: 20px;
            border: 1px solid rgba(39, 174, 96, 0.3);
            transition: all 0.3s ease;
            box-shadow: 0 0 20px rgba(39, 174, 96, 0.3);
            opacity: 0;
            animation: fadeInUp 0.5s ease-out forwards;
            animation-delay: calc(2.5s + (var(--order, 0) * 0.1s));
        }

        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        section:nth-child(1) { --order: 1; }
        section:nth-child(2) { --order: 2; }
        section:nth-child(3) { --order: 3; }
        section:nth-child(4) { --order: 4; }
        section:nth-child(5) { --order: 5; }
        section:nth-child(6) { --order: 6; }
        section:nth-child(7) { --order: 7; }

        section:hover {
            box-shadow: 0 0 30px rgba(39, 174, 96, 0.5);
            border-color: rgba(39, 174, 96, 0.6);
        }

        h2 {
            color: var(--ghost-neon-green);
            text-transform: uppercase;
            font-size: 1.2em;
            border-bottom: 1px solid var(--ghost-dark-green);
            padding-bottom: 10px;
            margin-top: 0;
        }

        .ghost-line {
            font-size: 1.5em;
            color: var(--ghost-cream);
            text-align: center;
            font-weight: bold;
            white-space: nowrap;
            margin: 25px 0;
            display: block;
            opacity: 0;
            animation: fadeIn 0.5s ease-in 2.3s forwards;
        }

        .download-soon-img {
            display: block;
            margin: 50px auto;
            max-width: 320px;
            width: 90%;
            height: auto;
            filter: drop-shadow(0 0 15px rgba(39, 174, 96, 0.4));
            transition: transform 0.3s ease, filter 0.3s ease;
        }

        .download-soon-img:hover {
            transform: scale(1.05);
            filter: drop-shadow(0 0 25px rgba(39, 174, 96, 0.6));
        }

        @media (max-width: 768px) {
            .reel-viewport {
                gap: 4px;
                padding: 0 12px;
                height: 50px;
            }
            .slot-char {
                height: 50px;
