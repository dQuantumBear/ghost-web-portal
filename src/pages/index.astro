<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Secure Messenger | Sovereign Ghost Protocol</title>
    <style>
        :root {
            --bg-black: #000000;
            --ghost-dark-green: #004D00;
            --ghost-neon-green: #27AE60;
            --ghost-white: #FFFFFF;
            --ghost-cream: #FFFDD0;
            --ghost-red: #FF0000;
            --ghost-dark-red: #8B0000;
        }

        html { scroll-behavior: smooth; }

        body {
            background-color: var(--bg-black);
            color: var(--ghost-white);
            font-family: 'Courier New', Courier, monospace;
            margin: 0;
            padding: 0;
            line-height: 1.4;
            position: relative;
            overflow-x: hidden;
            box-sizing: border-box;
        }

        *, *:before, *:after { box-sizing: inherit; }

        /* Modal Overlay */
        .modal-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.85);
            backdrop-filter: blur(8px);
            z-index: 2000;
            justify-content: center;
            align-items: center;
        }

        .modal-content {
            position: relative;
            background-color: var(--bg-black);
            border: 2px solid var(--ghost-neon-green);
            border-radius: 16px;
            max-width: 500px;
            width: 90%;
            max-height: 80vh;
            overflow-y: auto;
            box-shadow: 0 0 40px rgba(39, 174, 96, 0.5);
            animation: modalFadeIn 0.3s ease-out;
        }

        @keyframes modalFadeIn {
            from { opacity: 0; transform: scale(0.95); }
            to { opacity: 1; transform: scale(1); }
        }

        .modal-header {
            padding: 20px 25px 10px 25px;
            border-bottom: 1px solid var(--ghost-dark-green);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .modal-header h2 { margin: 0; color: var(--ghost-neon-green); text-transform: uppercase; font-size: 1.3em; }

        .close-modal {
            background: none;
            border: none;
            color: var(--ghost-neon-green);
            font-size: 28px;
            cursor: pointer;
            width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: 0.2s;
        }

        .close-modal:hover { background-color: var(--ghost-dark-green); border-radius: 50%; }

        .modal-body { padding: 20px 25px; font-size: 0.9em; line-height: 1.6; color: var(--ghost-cream); }

        .accept-btn {
            display: block;
            width: 100%;
            padding: 12px;
            margin-top: 20px;
            background-color: transparent;
            border: 2px solid var(--ghost-neon-green);
            color: var(--ghost-neon-green);
            font-weight: bold;
            cursor: pointer;
            border-radius: 8px;
            transition: 0.3s;
            font-family: inherit;
        }

        .accept-btn:hover { background-color: var(--ghost-dark-green); color: var(--ghost-white); }

        /* Navigation Menu */
        .menu-container {
            position: absolute;
            top: 20px;
            right: 20px;
            z-index: 1000;
        }

        .menu-icon {
            width: 50px;
            height: auto;
            cursor: pointer;
            filter: drop-shadow(0 0 5px var(--ghost-neon-green));
            transition: 0.3s;
        }

        .menu-icon:hover { transform: scale(1.1); }

        .dropdown-content {
            display: none;
            position: absolute;
            right: 0;
            top: 100%;
            background-color: var(--bg-black);
            min-width: 240px;
            border: 2px solid var(--ghost-neon-green);
            border-radius: 8px;
            box-shadow: 0 0 20px rgba(39, 174, 96, 0.4);
            padding: 10px 0;
            z-index: 1001;
        }

        .menu-container:hover .dropdown-content { display: block; }

        .dropdown-content a {
            color: var(--ghost-white);
            padding: 12px 20px;
            text-decoration: none;
            display: block;
            font-size: 0.9em;
            text-transform: uppercase;
            font-weight: bold;
            transition: 0.2s;
            border-bottom: 1px solid rgba(39, 174, 96, 0.1);
        }

        .dropdown-content a:hover { background-color: var(--ghost-dark-green); color: var(--ghost-neon-green); }

        header {
            padding: 60px 10px;
            text-align: center;
            background: linear-gradient(to bottom, var(--ghost-dark-green), var(--bg-black));
            border-bottom: 1px solid var(--ghost-neon-green);
            overflow: hidden;
        }

        .logo {
            max-width: 120px;
            height: auto;
            margin-bottom: 15px;
            animation: redToGreenGlow 3s ease-in-out infinite;
        }

        @keyframes redToGreenGlow {
            0% { filter: drop-shadow(0 0 5px #FF0000); opacity: 1; }
            50% { filter: drop-shadow(0 0 20px #27AE60); opacity: 1; }
            100% { filter: drop-shadow(0 0 5px #FF0000); opacity: 1; }
        }

        /* Slot Engine Title */
        :root {
            --neon-green: #39ff14;
            --container-bg: #111;
            --text-color: #fff;
            --box-size: 50px;
        }

        .row-container {
            display: flex;
            flex-direction: row;
            gap: 5px;
            position: relative;
            justify-content: center;
            width: 100%;
        }

        .letter-container {
            width: var(--box-size);
            height: var(--box-size);
            background-color: var(--container-bg);
            border: 1px solid #333;
            border-radius: 4px;
            overflow: hidden;
            position: relative;
            display: flex;
            justify-content: center;
            align-items: center;
            flex-shrink: 0;
        }

        .spinning-char { font-size: 32px; font-weight: bold; color: var(--text-color); position: absolute; }

        .letter-container.revealed .spinning-char {
            color: var(--neon-green);
            text-shadow: 0 0 10px var(--neon-green);
        }

        /* MOBILE FIX: Fluid scaling for the 17-character title */
        @media (max-width: 900px) {
            :root { --box-size: clamp(12px, 5vw, 24px); }
            .spinning-char { font-size: clamp(10px, 4vw, 20px); }
            .row-container { gap: 0.5vw; padding: 0 10px; }
            #title-container { font-size: 1.4em; min-height: 2.5em; }
        }

        #title-container {
            color: var(--ghost-cream);
            text-transform: uppercase;
            letter-spacing: 3px;
            font-size: 2.2em;
            margin: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 3.6em;
            opacity: 0;
            animation: fadeIn 0.1s forwards;
            width: 100%;
        }

        .tagline {
            color: var(--ghost-neon-green);
            font-weight: bold;
            font-size: 1em;
            margin-top: 5px;
            opacity: 0;
            animation: fadeIn 0.5s ease-in 2.5s forwards;
        }

        @keyframes fadeIn { to { opacity: 1; } }

        .container { max-width: 800px; margin: 0 auto; padding: 20px; }

        section {
            background-color: rgba(0, 77, 0, 0.1);
            margin-bottom: 30px;
            padding: 25px;
            border-radius: 20px;
            border: 1px solid rgba(39, 174, 96, 0.3);
            opacity: 0;
            animation: fadeInUp 0.5s ease-out forwards;
            animation-delay: 2.5s;
        }

        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .ghost-line {
            font-size: 1.5em;
            color: var(--ghost-cream);
            text-align: center;
            font-weight: bold;
            margin: 25px 0;
            display: block;
            opacity: 0;
            animation: fadeIn 0.5s ease-in 2.3s forwards;
        }

        @media (max-width: 480px) {
            .ghost-line { font-size: 1.05em; }
            section { padding: 15px; }
            .logo { max-width: 90px; }
            header { padding: 40px 10px; }
        }

        .bear-img {
            max-width: 150px;
            border-radius: 50%;
            border: 2px solid var(--ghost-neon-green);
            margin-bottom: 20px;
        }

        .highlight { color: var(--ghost-neon-green); font-weight: bold; }

        footer {
            text-align: center;
            padding: 40px 20px;
            font-size: 0.8em;
            color: #777;
            background: #050505;
        }
    </style>
</head>
<body>

    <div class="menu-container">
        <img src="menu_icon.png" alt="Menu" class="menu-icon">
        <div class="dropdown-content">
            <a href="https://glokta1991.github.io/legal-docs/privacy.html" target="_blank">Privacy Policy</a>
            <a href="https://glokta1991.github.io/legal-docs/white_paper.html" target="_blank">White Paper</a>
            <a id="cookiePolicyLink" style="cursor: pointer;">Cookie Policy</a>
            <a id="impressumLink" style="cursor: pointer;">Impressum</a>
        </div>
    </div>

    <!-- Modals -->
    <div id="cookieModal" class="modal-overlay">
        <div class="modal-content">
            <div class="modal-header"><h2>Cookie Policy</h2><button class="close-modal" id="closeCookieModalBtn">×</button></div>
            <div class="modal-body"><p>SecureMessenger is engineered for Stateless Privacy. I do not track users or use behavior cookies.</p><button id="acceptCookieBtn" class="accept-btn">✓ ACCEPT</button></div>
        </div>
    </div>

    <div id="impressumModal" class="modal-overlay">
        <div class="modal-content">
            <div class="modal-header"><h2>Impressum</h2><button class="close-modal" id="closeImpressumModalBtn">×</button></div>
            <div class="modal-body"><p>Individual Entrepreneur<br>c/o IP-Management #9966<br>Ludwig-Erhard-Straße 18<br>20459 Hamburg</p><button id="closeImpressumAcceptBtn" class="accept-btn">✓ CLOSE</button></div>
        </div>
    </div>

    <header>
        <img src="glass_logo.png" alt="Secure Messenger Logo" class="logo">
        <div id="title-container">
            <div class="row-container" id="main-row"></div>
        </div>
        <p class="tagline">Sovereign Build v10.8.3 | The Architecture of Privacy</p>
    </header>

    <div class="container">
        <span class="ghost-line">"To you, I am a conduit. To the world, you are a Ghost."</span>

        <section style="text-align: center; border: 1px solid var(--ghost-neon-green);">
            <img src="bear_panic.png" alt="dQuantumBear" class="bear-img">
            <h2>Built by One. Powered by You.</h2>
            <p>PayPal: <span class="highlight">nexus.mnemonic@gmail.com</span></p>
            <p class="highlight">— dQuantumBear</p>
        </section>

        <!-- DOWNLOAD IMAGE playstore.png -->
        <img src="playstore.png" alt="Download APK Soon" style="width: 100%; max-width: 400px; margin: 20px auto; display: block;">

        <section style="text-align: center; background: transparent; border: none;">
            <div class="highlight">NO PHONE NUMBERS • NO METADATA • NO SURVEILLANCE</div>
        </section>
    </div>

    <footer>
        <img src="app_icon_bear.jpg" alt="Sovereign Bear" style="max-width: 60px; margin-top: 20px;"><br>
        <span style="font-size: 1.5em;">🐻❤️M</span><br>
        &copy; 2026 Secure Messenger Project.
    </footer>

    <script>
        const targetStr = "SECURE MESSENGER "; 
        const charset = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%^&*()_+-=[]{}|;:,.<>?";
        const row = document.getElementById('main-row');
        const containers = [];

        for (let i = 0; i < 17; i++) {
            const container = document.createElement('div');
            container.className = 'letter-container';
            const charSpan = document.createElement('span');
            charSpan.className = 'spinning-char';
            charSpan.textContent = charset[Math.floor(Math.random() * charset.length)];
            container.appendChild(charSpan);
            row.appendChild(container);
            containers.push({ textNode: charSpan, target: targetStr[i], isRevealed: false, spinSpeed: 50 + Math.random() * 50 });
        }

        function spin(index) {
            const c = containers[index];
            if (c.isRevealed) return;
            c.textNode.textContent = charset[Math.floor(Math.random() * charset.length)];
            setTimeout(() => spin(index), c.spinSpeed);
        }

        for (let i = 0; i < 17; i++) spin(i);

        function revealNext(index) {
            if (index >= 17) return;
            const c = containers[index];
            c.isRevealed = true;
            c.textNode.textContent = c.target;
            c.textNode.parentElement.classList.add('revealed');
            setTimeout(() => revealNext(index + 1), 150);
        }

        setTimeout(() => revealNext(0), 7000);

        // Modal Logic
        const cookieModal = document.getElementById('cookieModal');
        const impressumModal = document.getElementById('impressumModal');
        document.getElementById('cookiePolicyLink').onclick = () => cookieModal.style.display = 'flex';
        document.getElementById('impressumLink').onclick = () => impressumModal.style.display = 'flex';
        document.getElementById('closeCookieModalBtn').onclick = () => cookieModal.style.display = 'none';
        document.getElementById('closeImpressumModalBtn').onclick = () => impressumModal.style.display = 'none';
        document.getElementById('acceptCookieBtn').onclick = () => cookieModal.style.display = 'none';
        document.getElementById('closeImpressumAcceptBtn').onclick = () => impressumModal.style.display = 'none';
        window.onclick = (e) => { if (e.target == cookieModal) cookieModal.style.display = 'none'; if (e.target == impressumModal) impressumModal.style.display = 'none'; }
    </script>
</body>
</html>
